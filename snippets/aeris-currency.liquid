{%- liquid
  assign aeris_active_currency = localization.country.currency.iso_code
  assign aeris_show_usd = false
  if aeris_active_currency == 'USD' or localization.country.iso_code == 'US'
    assign aeris_show_usd = true
  endif
-%}
<div class="aeris-currency">
  <link
    rel="preload"
    href="{{ 'localization-form.css' | asset_url }}"
    as="style"
    onload="this.onload=null;this.rel='stylesheet';"
  >
  <link rel="stylesheet" href="{{ 'component-country-flag.css' | asset_url }}" media="print" onload="this.media='all'">
  <div class="country-switcher aeris-currency__switcher">
    <div class="f-disclosure f-disclosure--up" data-aeris-currency-root>
      <h2 class="visually-hidden" id="CountryLabel-AerisCurrency">Currency</h2>
      <button
        type="button"
        class="f-disclosure__toggle text-normal"
        aria-expanded="false"
        aria-controls="AerisCurrencyList"
        aria-describedby="CountryLabel-AerisCurrency"
        data-aeris-currency-toggle
      >
        <span
          class="f-country-flags f-country-flags--{% if aeris_show_usd %}US{% else %}ID{% endif %}"
          data-aeris-currency-flag
        ></span>
        <span data-aeris-currency-label>{% if aeris_active_currency == 'USD' %}USD{% else %}IDR{% endif %}</span>
        {% comment %} theme-check-disable {% endcomment %}
        {{ 'icon-arrow-down.svg' | inline_asset_content }}
        {% comment %} theme-check-enable {% endcomment %}
      </button>
      <ul id="AerisCurrencyList" class="f-disclosure-list scroll-container text-left">
        <li class="f-disclosure-list__item" data-aeris-currency-item="IDR">
          <a class="f-disclosure-list__option" href="{{ request.path }}" data-aeris-currency="IDR">
            <span class="f-country-flags f-country-flags--ID"></span>
            Indonesia
            <span class="localization-form__currency">(IDR Rp)</span>
          </a>
        </li>
        <li class="f-disclosure-list__item" data-aeris-currency-item="USD">
          <a class="f-disclosure-list__option" href="{{ request.path }}" data-aeris-currency="USD">
            <span class="f-country-flags f-country-flags--US"></span>
            United States
            <span class="localization-form__currency">(USD $)</span>
          </a>
        </li>
      </ul>
    </div>
  </div>
</div>
<script src="{{ 'aeris-currency.js' | asset_url }}" defer="defer"></script>
<style>
  .aeris-currency {
    position: fixed;
    z-index: 110;
    inset-inline-start: 1.6rem;
    inset-inline-end: auto;
    inset-block-end: 1.6rem;
  }
  @media (max-width: 767.98px) {
    .aeris-currency {
      inset-block-end: calc(var(--f-mobile-navbar-height, 0px) + 1.6rem);
    }
  }
  :has(.sticky-atc-bar.sticky-atc-bar--show) .aeris-currency {
    inset-block-end: calc(var(--f-sticky-atc-bar-height, 0px) + 1.6rem);
  }
  @media (max-width: 767.98px) {
    :has(.sticky-atc-bar.sticky-atc-bar--show) .aeris-currency {
      inset-block-end: calc(var(--f-mobile-navbar-height, 0px) + var(--f-sticky-atc-bar-height, 0px) + 1.6rem);
    }
  }
  .aeris-currency .country-switcher {
    --f-max-width: 26rem;
  }
  .aeris-currency .f-disclosure__toggle {
    height: 3.8rem;
    padding: 0 1.2rem;
    border: 0;
    border-radius: 999px;
    background: #fff;
    color: #222;
    box-shadow: 0 0.6rem 2.4rem rgba(0, 0, 0, 0.16);
    column-gap: 0.4rem;
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  .aeris-currency .f-disclosure__toggle svg {
    width: 1rem;
    height: 1rem;
  }
  .aeris-currency .f-disclosure__toggle:hover {
    box-shadow: 0 0.8rem 2.8rem rgba(0, 0, 0, 0.2);
    transform: scale(1.04);
  }
  .aeris-currency .f-disclosure-list {
    inset-inline-start: 0;
    inset-inline-end: auto;
    top: auto;
    bottom: 100%;
    min-width: 22rem;
    margin: 0 0 0.8rem;
    padding: 0.8rem;
    border: 0;
    border-radius: 1.6rem;
    background: #fff;
    box-shadow: 0 1.2rem 3.2rem rgba(0, 0, 0, 0.16);
  }
  .aeris-currency .f-disclosure-list__item {
    line-height: 1.3 !important;
  }
  .aeris-currency .f-disclosure-list__item a {
    padding: 0.8rem 1rem;
    border-radius: 1rem;
    text-decoration: none;
  }
  .aeris-currency .f-disclosure-list__item a:hover,
  .aeris-currency .f-disclosure-list__item--current a {
    background: #f6f3ee;
    text-decoration: none;
  }
</style>
