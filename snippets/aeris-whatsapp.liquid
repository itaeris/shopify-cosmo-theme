{%- liquid
  assign wa_number = settings.aeris_whatsapp_number | default: '085286142105'
  assign wa_digits = wa_number | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '.'
  if wa_digits.first == '0'
    assign wa_digits = wa_digits | remove_first: '0' | prepend: '62'
  endif
  assign wa_link = 'https://wa.me/' | append: wa_digits
  if settings.aeris_whatsapp_message != blank
    assign wa_text = settings.aeris_whatsapp_message | strip | url_encode
    assign wa_link = wa_link | append: '?text=' | append: wa_text
  endif
-%}
{%- if settings.aeris_whatsapp_enable and wa_digits != blank -%}
<a
  class="aeris-whatsapp"
  href="{{ wa_link }}"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat WhatsApp {{ wa_number | escape }}"
>
  <img src="{{ 'aeris-whatsapp.png' | asset_url }}" alt="" width="52" height="52">
</a>
<style>
  .aeris-whatsapp {
    position: fixed;
    z-index: 110;
    inset-inline-end: 1.6rem;
    inset-block-end: 1.6rem;
    display: block;
    width: 5.2rem;
    height: 5.2rem;
    background: none;
    line-height: 0;
  }
  .aeris-whatsapp img {
    display: block;
    width: 100%;
    height: 100%;
  }
  .aeris-whatsapp:hover {
    background: none;
    transform: scale(1.06);
  }
  @media (max-width: 767.98px) {
    .aeris-whatsapp {
      inset-block-end: calc(var(--f-mobile-navbar-height, 0px) + 1.6rem);
    }
  }
  :has(.sticky-atc-bar.sticky-atc-bar--show) .aeris-whatsapp {
    inset-block-end: calc(var(--f-sticky-atc-bar-height, 0px) + 1.6rem);
  }
  @media (max-width: 767.98px) {
    :has(.sticky-atc-bar.sticky-atc-bar--show) .aeris-whatsapp {
      inset-block-end: calc(var(--f-mobile-navbar-height, 0px) + var(--f-sticky-atc-bar-height, 0px) + 1.6rem);
    }
  }
</style>
{%- endif -%}
