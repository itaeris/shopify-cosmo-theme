{%- liquid
  assign bag = all_products['coco-vanity-bag']
  assign pouch = all_products['aeris-beaute-clear-smart-travel-pouch']
-%}
<section class="aeris-personal">
  <div class="aeris-personal__crumbs">
    <div class="container">
      <nav class="breadcrumbs flex justify-center" aria-label="breadcrumbs">
        <a href="{{ routes.root_url }}">Home</a>
        <span class="breadcrumbs--sep" aria-hidden="true">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4.5 2.25L8.25 6L4.5 9.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <a href="{{ routes.all_products_collection_url }}">Collection</a>
        <span class="breadcrumbs--sep" aria-hidden="true">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4.5 2.25L8.25 6L4.5 9.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <span class="breadcrumbs--last">Personalization</span>
      </nav>
    </div>
  </div>

  <div class="aeris-personal__banner">
    {%- if section.settings.banner_image != blank or section.settings.banner_image_mobile != blank -%}
      {% render 'aeris-banner-picture',
        image: section.settings.banner_image,
        mobile_image: section.settings.banner_image_mobile,
        alt: 'Personalization',
        image_class: 'aeris-personal__banner-image'
      %}
    {%- else -%}
      <img
        class="aeris-personal__banner-image"
        src="{{ 'Coco_desktop.jpg' | file_img_url: '2000x' }}"
        alt="Personalization"
        width="2000"
        height="472"
      >
    {%- endif -%}
    <h1>Personalization</h1>
  </div>

  {%- if section.settings.coming_soon -%}
  <div class="aeris-personal__intro aeris-personal__soon container">
    {%- if section.settings.soon_heading != blank -%}
      <h2>{{ section.settings.soon_heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.soon_text != blank -%}
      <div class="rte">{{ section.settings.soon_text }}</div>
    {%- endif -%}
  </div>
  {%- else -%}
  <div class="aeris-personal__intro container">
    <h2>Add a personal touch</h2>
    <p>Elevate your Vanity Bag or gift with a personalised monogram and bag charm. Simply, select personalisation before adding to bag.</p>
  </div>

  <div class="aeris-personal__steps container">
    <a class="aeris-personal__step" href="{{ bag.url | default: '/products/coco-vanity-bag' }}">
      <img src="{{ 'TT_02644.jpg' | file_img_url: '900x' }}" alt="Select Coco Vanity Bag color" width="900" height="1100">
      <span>1. Select Coco Vanity Bag color</span>
    </a>
    <a class="aeris-personal__step" href="{{ bag.url | default: '/products/coco-vanity-bag' }}">
      <img src="{{ 'AE828.jpg' | file_img_url: '900x' }}" alt="Monogram your bag" width="900" height="1100">
      <span>2. Monogram your bag</span>
    </a>
    <a class="aeris-personal__step" href="{% if pouch.id != blank %}{{ pouch.url }}{% else %}/collections/lifestyle-bags{% endif %}">
      {%- if pouch.id != blank and pouch.featured_image != blank -%}
        <img src="{{ pouch.featured_image | image_url: width: 900 }}" alt="Choose your charm" width="900" height="1100">
      {%- else -%}
        <img src="{{ 'Coco_desktop.jpg' | file_img_url: '900x' }}" alt="Choose your charm" width="900" height="1100">
      {%- endif -%}
      <span>3. Choose your charm</span>
    </a>
  </div>

  {%- if section.settings.product_list != blank -%}
    <div class="aeris-personal__products container">
      {%- if section.settings.products_heading != blank -%}
        <h2>{{ section.settings.products_heading }}</h2>
      {%- endif -%}
      <div class="aeris-personal__product-grid f-grid f-grid--gap-medium f-grid-2-cols md:f-grid-2-cols">
        {%- for product in section.settings.product_list -%}
          <div class="f-column">
            {% render 'product-card', product: product, image_ratio: '1/1' %}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
  {%- endif -%}
</section>

{% style %}
  .aeris-personal__crumbs {
    padding: 2.4rem 0 1.6rem;
  }
  .aeris-personal__banner {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: #f3f1ec;
    container-type: inline-size;
  }
  .aeris-personal__banner picture,
  .aeris-personal__banner img,
  .aeris-personal__banner-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center center;
    display: block;
  }
  .aeris-personal__banner h1 {
    position: absolute;
    inset: 0;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 2cqw;
    color: #fff;
    font-family: Newsreader, Georgia, serif;
    font-weight: 400;
    font-size: 3.61cqw;
    letter-spacing: 0.16em;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    text-shadow: 0 0.04em 0.35em rgba(0, 0, 0, 0.28);
  }
  .aeris-personal__intro {
    padding: 4.8rem 1.6rem 1.6rem;
    text-align: center;
    max-width: 760px;
  }
  .aeris-personal__soon {
    padding-bottom: 8rem;
  }
  .aeris-personal__intro h2,
  .aeris-personal__products h2 {
    margin: 0 0 1.2rem;
    font-family: Newsreader, Georgia, serif;
    font-weight: 500;
    font-size: 2.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .aeris-personal__intro p {
    margin: 0 auto;
    max-width: 62rem;
    line-height: 1.6;
  }
  .aeris-personal__steps {
    display: grid;
    grid-template-columns: 1fr;
    justify-content: center;
    gap: 1.6rem;
    max-width: 920px;
    margin-inline: auto;
    padding: 2.4rem 1.6rem 0.8rem;
  }
  .aeris-personal__step {
    text-decoration: none;
    color: inherit;
    text-align: center;
  }
  .aeris-personal__step img {
    width: 100%;
    height: 280px;
    object-fit: cover;
    object-position: center;
    display: block;
    background: #f4f1ec;
    border-radius: 1.2rem;
  }
  .aeris-personal__step span {
    display: block;
    margin-top: 1.2rem;
    font-size: 1.2rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .aeris-personal__products {
    padding: 3.2rem 1.6rem 5rem;
    text-align: center;
  }
  .aeris-personal__product-grid {
    max-width: 72rem;
    margin-inline: auto;
    text-align: initial;
  }
  @media (min-width: 750px) {
    .aeris-personal__banner {
      aspect-ratio: 1440 / 340;
    }
    .aeris-personal__steps {
      grid-template-columns: repeat(3, minmax(0, 280px));
      gap: 1.6rem;
    }
    .aeris-personal__step img {
      height: 320px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Aeris personalisation",
  "settings": [
    {
      "type": "checkbox",
      "id": "coming_soon",
      "label": "Coming soon",
      "info": "Kalau aktif, halaman hanya menampilkan banner dan pesan coming soon.",
      "default": true
    },
    {
      "type": "text",
      "id": "soon_heading",
      "label": "Judul coming soon",
      "default": "Coming Soon"
    },
    {
      "type": "richtext",
      "id": "soon_text",
      "label": "Teks coming soon",
      "default": "<p>Personalised monograms and bag charms for your Coco Vanity Bag are on their way. Stay tuned.</p>"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner, desktop",
      "info": "2880 × 680 px."
    },
    {
      "type": "image_picker",
      "id": "banner_image_mobile",
      "label": "Banner, HP",
      "info": "1500 × 800 px. Kalau kosong, foto desktop dipotong mengikuti layar."
    },
    {
      "type": "text",
      "id": "products_heading",
      "label": "Product heading",
      "default": "Start with your bag"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Products",
      "limit": 8,
      "info": "Pilih produk di theme editor. Bisa ditambah, dihapus, dan diurutkan."
    }
  ],
  "presets": [
    {
      "name": "Aeris personalisation"
    }
  ]
}
{% endschema %}
