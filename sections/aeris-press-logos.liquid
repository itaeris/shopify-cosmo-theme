<div
  id="AerisPressLogos-{{ section.id }}"
  class="aeris-press-logos f-section-padding color-{{ section.settings.color_schema }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="{{ section.settings.container }}">
    <div class="aeris-press-logos__row">
      {% for block in section.blocks %}
        <div class="aeris-press-logos__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 360
              | image_tag:
                loading: 'lazy',
                widths: '160, 240, 360',
                sizes: '160px',
                class: 'aeris-press-logos__image'
            }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'aeris-press-logos__placeholder placeholder-svg' }}
          {%- endif -%}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  #AerisPressLogos-{{ section.id }} .aeris-press-logos__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 3.2rem 4.8rem;
  }

  #AerisPressLogos-{{ section.id }} .aeris-press-logos__item {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 16rem;
    height: 6.4rem;
  }

  #AerisPressLogos-{{ section.id }} .aeris-press-logos__image,
  #AerisPressLogos-{{ section.id }} .aeris-press-logos__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 6.4rem;
    object-fit: contain;
  }

  #AerisPressLogos-{{ section.id }} .aeris-press-logos__placeholder {
    background: #f3f1ee;
  }

  @media (max-width: 767.98px) {
    #AerisPressLogos-{{ section.id }} .aeris-press-logos__item {
      width: 12.8rem;
      height: 5.2rem;
    }
  }
</style>

{% schema %}
{
  "name": "Press logos",
  "settings": [
    {
      "type": "select",
      "id": "container",
      "label": "Container",
      "default": "container",
      "options": [
        { "value": "container", "label": "Fixed" },
        { "value": "container-fluid", "label": "Stretched" },
        { "value": "container-full", "label": "Full width" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_schema",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press logos",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
