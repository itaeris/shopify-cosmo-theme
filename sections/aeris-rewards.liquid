<section class="aeris-rewards">
  <nav class="aeris-rewards__crumbs" aria-label="breadcrumbs">
    <a href="{{ routes.root_url }}">Home</a>
    <span aria-hidden="true">›</span>
    <span>Rewards Program</span>
  </nav>
  <div class="aeris-rewards__banner">
    <img src="{{ 'TT_02644.jpg' | file_img_url: '2000x' }}" alt="" width="2000" height="2000">
  </div>

  <div class="aeris-rewards__intro">
    <h1>Aeris Rewards</h1>
    <p>Welcome to Aeris Rewards. Earn points for every purchase and use them to unlock tiers, redeem rewards and more.</p>
    <ol>
      <li>
        <strong>1 – Join</strong>
        <span>Join the program with a simple click. It is free to join.</span>
      </li>
      <li>
        <strong>2 – Earn</strong>
        <span>Earn points for every purchase.</span>
      </li>
      <li>
        <strong>3 – Redeem</strong>
        <span>Use your points to redeem member rewards.</span>
      </li>
    </ol>
    <a class="aeris-rewards__btn" href="{{ routes.account_register_url }}">Join now</a>
  </div>

  <div class="aeris-rewards__redeem">
    <h2>How to redeem points?</h2>
    <div class="aeris-rewards__steps">
      <article>
        <div class="aeris-rewards__step-art" aria-hidden="true">
          <svg viewBox="0 0 120 150" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="28" y="8" width="64" height="134" rx="8" stroke="#1c1c1c" stroke-width="2"/>
            <rect x="38" y="28" width="44" height="8" rx="2" fill="#1c1c1c"/>
            <rect x="38" y="46" width="44" height="8" rx="2" fill="#d9d3cb"/>
            <rect x="38" y="64" width="28" height="8" rx="2" fill="#d9d3cb"/>
            <rect x="46" y="96" width="28" height="22" rx="4" fill="#1c1c1c"/>
          </svg>
        </div>
        <h3>Login to redeem</h3>
        <p>Sign in to your Aeris account and open your rewards.</p>
      </article>
      <article>
        <div class="aeris-rewards__step-art" aria-hidden="true">
          <svg viewBox="0 0 120 150" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="34" y="36" width="52" height="52" rx="6" stroke="#1c1c1c" stroke-width="2"/>
            <path d="M60 36v52M34 62h52" stroke="#1c1c1c" stroke-width="2"/>
            <path d="M44 36c0-8 6-12 16-12s16 4 16 12" stroke="#1c1c1c" stroke-width="2"/>
          </svg>
        </div>
        <h3>Redeem for rewards</h3>
        <p>Choose a reward and redeem it with your points.</p>
      </article>
      <article>
        <div class="aeris-rewards__step-art" aria-hidden="true">
          <svg viewBox="0 0 120 150" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="22" y="28" width="76" height="96" rx="6" stroke="#1c1c1c" stroke-width="2"/>
            <rect x="32" y="42" width="40" height="8" rx="2" fill="#1c1c1c"/>
            <rect x="32" y="60" width="56" height="6" rx="2" fill="#d9d3cb"/>
            <rect x="32" y="74" width="48" height="6" rx="2" fill="#d9d3cb"/>
            <rect x="32" y="96" width="28" height="14" rx="3" fill="#1c1c1c"/>
          </svg>
        </div>
        <h3>Get exclusive perks</h3>
        <p>Enjoy member offers, early access, and birthday gifts.</p>
      </article>
    </div>
    <a class="aeris-rewards__btn" href="{{ routes.account_register_url }}">Join now</a>
  </div>

  <div class="aeris-rewards__perks">
    <h2>Perks of joining Aeris Rewards</h2>
    <ul>
      <li>
        <svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="14" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M24 16v16M18 22h8.5a3.5 3.5 0 0 1 0 7H20" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        <span>Earn points on every eligible order</span>
      </li>
      <li>
        <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M10 30V18l14-6 14 6v12l-14 6-14-6z" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M24 24v12M10 18l14 6 14-6" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        <span>Enjoy member-only promotions</span>
      </li>
      <li>
        <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M16 22h16v14H16z" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M16 26h16M24 22v14M20 22c0-4 8-4 8 0" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        <span>Get a welcome offer on your first order</span>
      </li>
      <li>
        <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 14l2.4 6.6H34l-5.6 4.2 2.2 6.6L24 27.4 17.4 31.4l2.2-6.6L14 20.6h7.6z" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        <span>Redeem exclusive rewards and partner perks</span>
      </li>
    </ul>
  </div>

  <div class="aeris-rewards__tiers">
    <p class="aeris-rewards__unlock">Unlock rewards as you shop</p>
    <div class="aeris-rewards__modes">
      <div>
        <strong>Self-Care Mode</strong>
        <span>Free to join</span>
      </div>
      <div>
        <strong>Vacation Mode</strong>
        <span>1.25x points</span>
      </div>
      <div>
        <strong>Golden Hour Mode</strong>
        <span>1.5x points</span>
      </div>
    </div>
    <h2>Aeris Rewards loyalty tiers</h2>
    <p>Earn more perks as you shop.</p>
    <div class="aeris-rewards__table-wrap">
      <table>
        <thead>
          <tr>
            <th></th>
            <th>Self-Care Mode<br><span>Free to join</span></th>
            <th>Vacation Mode<br><span>1.25x points</span></th>
            <th>Golden Hour Mode<br><span>1.5x points</span></th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th>Points per order</th>
            <td>1</td>
            <td>1.25</td>
            <td>1.50</td>
          </tr>
          <tr>
            <th>Free standard shipping</th>
            <td>Selected orders</td>
            <td>Selected orders</td>
            <td>All orders</td>
          </tr>
          <tr>
            <th>Entry gift</th>
            <td>Welcome offer</td>
            <td>Welcome offer</td>
            <td>Welcome offer</td>
          </tr>
          <tr>
            <th>Early access to sales and new products</th>
            <td>—</td>
            <td>+</td>
            <td>+</td>
          </tr>
          <tr>
            <th>Birthday gift</th>
            <td>+</td>
            <td>+</td>
            <td>+</td>
          </tr>
          <tr>
            <th>Exclusive annual gift</th>
            <td></td>
            <td></td>
            <td>+</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="aeris-rewards__faq">
    <div class="aeris-rewards__faq-inner">
      <h2>FAQ</h2>
      <p class="aeris-rewards__faq-lead">For the curious.<br>You asked, we answered.</p>
      <details>
        <summary>How do I join?</summary>
        <p>Create an Aeris account. Membership starts on the free Self-Care tier.</p>
      </details>
      <details>
        <summary>How do I earn/redeem points?</summary>
        <p>Points are added after an eligible order. Redeem them from your account once they are available.</p>
      </details>
      <details>
        <summary>How do the loyalty tiers work?</summary>
        <p>Your tier follows your activity with Aeris. Higher tiers unlock extra perks.</p>
      </details>
      <details>
        <summary>How does refer a friend work?</summary>
        <p>Share Aeris with a friend. Referral rewards appear once their qualifying order is complete.</p>
      </details>
      <details>
        <summary>How do I access my rewards?</summary>
        <p>Sign in and open your account to see points, tier, and available rewards.</p>
      </details>
    </div>
  </div>
</section>

{% style %}
  .aeris-rewards {
    padding-bottom: 0;
    color: #1c1c1c;
  }
  .aeris-rewards__crumbs {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    justify-content: center;
    padding: 1.8rem 1.6rem 1.4rem;
    color: #1c1c1c;
    font-size: 1.3rem;
  }
  .aeris-rewards__crumbs a {
    color: inherit;
    text-decoration: none;
  }
  .aeris-rewards__banner {
    width: 100%;
    height: 240px;
    overflow: hidden;
    background: #f3f1ec;
  }
  .aeris-rewards__banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
    display: block;
  }
  .aeris-rewards__intro,
  .aeris-rewards__redeem,
  .aeris-rewards__perks,
  .aeris-rewards__tiers {
    width: min(1080px, calc(100% - 3.2rem));
    margin: 0 auto;
    text-align: center;
  }
  .aeris-rewards__intro {
    padding: 3.2rem 1.6rem 2.4rem;
  }
  .aeris-rewards h1,
  .aeris-rewards h2 {
    margin: 0 0 1rem;
    font-family: Newsreader, Georgia, serif;
    font-weight: 500;
  }
  .aeris-rewards h1 {
    color: #1c1c1c;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: clamp(3.2rem, 4vw, 4.6rem);
  }
  .aeris-rewards__intro > p,
  .aeris-rewards__tiers > p {
    max-width: 62rem;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }
  .aeris-rewards__intro ol {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: grid;
    gap: 1.6rem;
  }
  .aeris-rewards__intro li {
    display: grid;
    gap: 0.4rem;
  }
  .aeris-rewards__intro strong {
    letter-spacing: 0.04em;
  }
  .aeris-rewards__btn {
    display: inline-block;
    padding: 0.9rem 2.2rem;
    background: #2a241c;
    color: #fff;
    text-decoration: none;
    letter-spacing: 0.04em;
    font-size: 1.3rem;
  }
  .aeris-rewards__redeem {
    margin-top: 1.6rem;
    padding: 3.2rem 1.6rem;
    background: #f7f4ef;
    width: 100%;
    max-width: none;
  }
  .aeris-rewards__redeem h2,
  .aeris-rewards__steps {
    width: min(1080px, 100%);
    margin-left: auto;
    margin-right: auto;
  }
  .aeris-rewards__steps {
    display: grid;
    gap: 1.6rem;
    margin: 2rem auto 2.4rem;
  }
  .aeris-rewards__steps article {
    background: #fff;
    padding: 1.6rem 1.4rem 2rem;
  }
  .aeris-rewards__step-art {
    height: 150px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .aeris-rewards__step-art svg {
    width: 92px;
    height: 120px;
  }
  .aeris-rewards__steps h3 {
    margin: 0.8rem 0 0.4rem;
    font-size: 1.5rem;
    font-weight: 600;
  }
  .aeris-rewards__steps p {
    margin: 0;
    font-size: 1.3rem;
    line-height: 1.5;
  }
  .aeris-rewards__perks {
    padding: 3.6rem 0 1rem;
  }
  .aeris-rewards__perks ul {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }
  .aeris-rewards__perks li {
    display: grid;
    justify-items: center;
    gap: 0.8rem;
    font-size: 1.3rem;
    line-height: 1.4;
  }
  .aeris-rewards__perks svg {
    width: 42px;
    height: 42px;
  }
  .aeris-rewards__unlock {
    margin: 0 0 1.4rem;
    font-family: Newsreader, Georgia, serif;
    font-size: 2.4rem;
  }
  .aeris-rewards__tiers {
    padding: 3.2rem 0 4rem;
  }
  .aeris-rewards__modes {
    display: grid;
    margin-bottom: 2.8rem;
  }
  .aeris-rewards__modes div {
    padding: 1.4rem 1.6rem;
    color: #16303a;
  }
  .aeris-rewards__modes strong,
  .aeris-rewards__modes span,
  .aeris-rewards thead span {
    display: block;
  }
  .aeris-rewards__modes span,
  .aeris-rewards thead span {
    font-size: 1.2rem;
    font-weight: 400;
  }
  .aeris-rewards__modes div:nth-child(1),
  .aeris-rewards thead th:nth-child(2) {
    background: #d7e7ef;
  }
  .aeris-rewards__modes div:nth-child(2),
  .aeris-rewards thead th:nth-child(3) {
    background: #b9d4e2;
  }
  .aeris-rewards__modes div:nth-child(3),
  .aeris-rewards thead th:nth-child(4) {
    background: #8fb9cc;
  }
  .aeris-rewards__table-wrap {
    overflow-x: auto;
  }
  .aeris-rewards table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: 1.3rem;
  }
  .aeris-rewards th,
  .aeris-rewards td {
    padding: 1rem 0.8rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    text-align: center;
  }
  .aeris-rewards tbody th {
    text-align: left;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 1.2rem;
  }
  .aeris-rewards thead th {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 1.2rem;
  }
  .aeris-rewards__faq {
    background: #eceae6;
    padding: 3.6rem 1.6rem 4.8rem;
  }
  .aeris-rewards__faq-inner {
    width: min(1080px, 100%);
    margin: 0 auto;
  }
  .aeris-rewards__faq h2 {
    font-family: Newsreader, Georgia, serif;
    font-size: 3.2rem;
    margin-bottom: 0.4rem;
  }
  .aeris-rewards__faq-lead {
    margin: 0 0 1.6rem;
    font-family: Newsreader, Georgia, serif;
    font-size: 2rem;
    line-height: 1.3;
  }
  .aeris-rewards__faq details {
    border-top: 1px solid rgba(0, 0, 0, 0.12);
  }
  .aeris-rewards__faq details:last-child {
    border-bottom: 1px solid rgba(0, 0, 0, 0.12);
  }
  .aeris-rewards__faq summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.6rem;
    padding: 1.3rem 0;
    cursor: pointer;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 1.2rem;
    list-style: none;
  }
  .aeris-rewards__faq summary::-webkit-details-marker {
    display: none;
  }
  .aeris-rewards__faq summary::after {
    content: "+";
    font-size: 2rem;
    font-weight: 300;
    line-height: 1;
  }
  .aeris-rewards__faq details[open] summary::after {
    content: "–";
  }
  .aeris-rewards__faq details p {
    margin: 0 0 1.2rem;
    max-width: 70rem;
  }
  @media (min-width: 750px) {
    .aeris-rewards__banner {
      height: 420px;
    }
    .aeris-rewards__intro ol,
    .aeris-rewards__steps,
    .aeris-rewards__perks ul {
      grid-template-columns: repeat(3, 1fr);
    }
    .aeris-rewards__perks ul {
      grid-template-columns: repeat(4, 1fr);
    }
    .aeris-rewards__modes {
      grid-template-columns: repeat(3, 1fr);
    }
    .aeris-rewards__modes div:nth-child(1) {
      clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 50%, calc(100% - 16px) 100%, 0 100%);
    }
    .aeris-rewards__modes div:nth-child(2) {
      clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 50%, calc(100% - 16px) 100%, 0 100%, 16px 50%);
      margin-left: -8px;
    }
    .aeris-rewards__modes div:nth-child(3) {
      clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%, 16px 50%);
      margin-left: -8px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Aeris rewards",
  "settings": [],
  "presets": [
    {
      "name": "Aeris rewards"
    }
  ]
}
{% endschema %}
