{%- liquid
  assign hide_hero = false
  if page.handle == 'terms-of-service' or page.handle == 'privacy-policy' or page.handle == 'terms' or page.handle == 'privacy'
    assign hide_hero = true
  endif
  if page.handle == 'about-us' or page.handle == 'our-story' or page.handle == 'about'
    assign hide_hero = true
  endif
  if page.handle == 'track-your-order' or page.handle == 'track-order'
    assign hide_hero = true
  endif
  if page.handle == 'contact-us' or page.handle == 'contact' or page.handle == 'contactus'
    assign hide_hero = true
  endif
  if page.handle == 'store-locations' or page.handle == 'store-location' or template.suffix == 'store-locations'
    assign hide_hero = true
  endif
  if request.path == '/pages/store-locations' or request.path == '/pages/store-location'
    assign hide_hero = true
  endif
  if page.handle == 'personalisation' or page.handle == 'personalization'
    assign hide_hero = true
  endif
  if request.path == '/pages/personalisation' or request.path == '/pages/personalization'
    assign hide_hero = true
  endif
  if template.suffix == 'about-us' or template.suffix == 'our-story'
    assign hide_hero = true
  endif
  if template.name == 'collection' or template.name == 'list-collections' or template.name == 'product'
    assign hide_hero = true
  endif
  if template.name == 'blog' or template.name == 'article'
    assign hide_hero = true
  endif
  if template.suffix == 'rewards' or template.suffix == 'aeris-circle'
    assign hide_hero = true
  endif
  if page.handle == 'faqs' or page.handle == 'faq' or template.suffix == 'faqs'
    assign hide_hero = true
  endif
  if template.name == 'login' or template.name == 'register'
    assign hide_hero = true
  endif
-%}
{% if hide_hero %}
  <style>
    #shopify-section-{{ section.id }} { display: none !important; }
  </style>
{% else %}
<section
  id="AerisHero-{{ section.id }}"
  class="aeris-hero"
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
>
  <div class="aeris-hero__slider">
    {% for block in section.blocks %}
      <div
        class="aeris-hero__slide {% if forloop.first %}is-active{% endif %}"
        data-slide="{{ forloop.index0 }}"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.background_image != blank %}
          <div class="aeris-hero__background">
            {{
              block.settings.background_image
              | image_url: width: 3000
              | image_tag:
                loading: 'eager',
                widths: '750, 1100, 1500, 2000, 2400, 3000',
                sizes: '100vw',
                class: 'aeris-hero__background-image'
            }}
          </div>
        {% else %}
          <div class="aeris-hero__background aeris-hero__background--placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          </div>
        {% endif %}

        <div
          class="aeris-hero__overlay"
          style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
        ></div>

        {% if block.settings.show_small_image and block.settings.small_image != blank %}
          <div class="aeris-hero__small-card">
            {{
              block.settings.small_image
              | image_url: width: 1000
              | image_tag:
                loading: 'lazy',
                widths: '300, 500, 700, 1000',
                sizes: '(max-width: 749px) 140px, 300px',
                class: 'aeris-hero__small-image'
            }}
          </div>
        {% endif %}

        <div class="aeris-hero__content">
          {% if block.settings.heading != blank %}
            <h2 class="aeris-hero__heading">
              {{ block.settings.heading }}
            </h2>
          {% endif %}

          {% if block.settings.subtitle != blank %}
            <div class="aeris-hero__subtitle">
              {{ block.settings.subtitle }}
            </div>
          {% endif %}

          {% if block.settings.button_text != blank %}
            <a
              href="{{ block.settings.button_link | default: '#' }}"
              class="aeris-hero__button"
            >
              {{ block.settings.button_text }}
            </a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>

  {% if section.blocks.size > 1 %}
    {% if section.settings.show_arrows %}
      <button
        class="aeris-hero__arrow aeris-hero__arrow--prev"
        type="button"
        aria-label="Previous slide"
      >
        ‹
      </button>

      <button
        class="aeris-hero__arrow aeris-hero__arrow--next"
        type="button"
        aria-label="Next slide"
      >
        ›
      </button>
    {% endif %}

    {% if section.settings.show_dots %}
      <div class="aeris-hero__dots">
        {% for block in section.blocks %}
          <button
            type="button"
            class="aeris-hero__dot {% if forloop.first %}is-active{% endif %}"
            data-dot="{{ forloop.index0 }}"
            aria-label="Go to slide {{ forloop.index }}"
          ></button>
        {% endfor %}
      </div>
    {% endif %}
  {% endif %}
</section>

<style>
  #shopify-section-{{ section.id }} {
    margin: 0;
    padding: 0;
    max-width: none;
  }

  #AerisHero-{{ section.id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #111;
  }

  #AerisHero-{{ section.id }} .aeris-hero__slider {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: {{ section.settings.desktop_height }}px;
  }

  #AerisHero-{{ section.id }} .aeris-hero__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: inherit;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transition:
      opacity 0.7s ease,
      visibility 0.7s ease;
  }

  @media screen and (min-width: 990px) {
    #AerisHero-{{ section.id }} {
      height: calc(100svh - var(--f-announcement-height, 36px));
      min-height: {{ section.settings.desktop_height }}px;
    }

    #AerisHero-{{ section.id }} .aeris-hero__slider,
    #AerisHero-{{ section.id }} .aeris-hero__slide {
      height: 100%;
      min-height: 100%;
    }
  }

  #AerisHero-{{ section.id }} .aeris-hero__slide.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    z-index: 2;
  }

  #AerisHero-{{ section.id }} .aeris-hero__background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #AerisHero-{{ section.id }} .aeris-hero__background-image,
  #AerisHero-{{ section.id }} .aeris-hero__background--placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  @media screen and (min-width: 990px) {
    #AerisHero-{{ section.id }} .aeris-hero__background-image {
      object-position: 42% center;
    }
  }

  #AerisHero-{{ section.id }} .aeris-hero__background--placeholder {
    background: #e5e5e5;
  }

  #AerisHero-{{ section.id }} .aeris-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;

    background: #000;

    pointer-events: none;
  }

  #AerisHero-{{ section.id }} .aeris-hero__small-card {
    position: absolute;
    z-index: 4;

    left: {{ section.settings.small_image_left }}px;
    bottom: {{ section.settings.small_image_bottom }}px;

    width: {{ section.settings.small_image_width }}px;
    max-width: calc(100vw - 48px);

    overflow: hidden;

    background: #f2f2f2;
    border: {{ section.settings.small_image_border_width }}px solid
      rgba(0, 0, 0, {{ section.settings.small_image_border_opacity | divided_by: 100.0 }});

    border-radius: {{ section.settings.small_image_radius }}px;

    box-shadow:
      0 10px 35px rgba(0, 0, 0, 0.12);
  }

  #AerisHero-{{ section.id }} .aeris-hero__small-image {
    display: block;
    width: 100%;
    height: auto;

    aspect-ratio: {{ section.settings.small_image_ratio }};

    object-fit: cover;
  }

  #AerisHero-{{ section.id }} .aeris-hero__content {
    position: absolute;
    z-index: 4;

    top: auto;
    left: auto;
    right: {{ section.settings.content_right }}%;
    bottom: {{ section.settings.content_bottom }}%;

    width: max-content;
    max-width: min(460px, 40vw);

    color: #fff;
    text-align: center;
  }

  @media screen and (min-width: 990px) {
    #AerisHero-{{ section.id }} .aeris-hero__content {
      right: clamp(4rem, 7.5vw, 12rem);
      bottom: clamp(7rem, 18vh, 18rem);
      max-width: min(34vw, 52rem);
    }
  }

  #AerisHero-{{ section.id }} .aeris-hero__heading {
    margin: 0;

    color: #fff;

    font-family: var(--font-heading-family);
    font-size: clamp(
      {{ section.settings.heading_min_size }}px,
      {{ section.settings.heading_desktop_size | divided_by: 12.0 }}vw,
      {{ section.settings.heading_desktop_size }}px
    );

    line-height: 0.92;
    font-weight: {{ section.settings.heading_weight }};
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #AerisHero-{{ section.id }} .aeris-hero__subtitle {
    margin-top: 12px;

    color: #fff;

    font-family: var(--font-heading-family);
    font-size: clamp(22px, 2.6vw, 40px);
    line-height: 1.15;
    font-style: normal;
    font-weight: 400;
    letter-spacing: 0.01em;
  }

  #AerisHero-{{ section.id }} .aeris-hero__subtitle p {
    margin: 0;
  }

  @media screen and (min-width: 990px) {
    #AerisHero-{{ section.id }} .aeris-hero__heading {
      font-size: clamp(5.2rem, 5vw, 9.6rem);
    }

    #AerisHero-{{ section.id }} .aeris-hero__subtitle {
      font-size: clamp(2.2rem, 2vw, 3.6rem);
    }
  }

  #AerisHero-{{ section.id }} .aeris-hero__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    margin-top: 22px;
    padding: 11px 28px;

    min-width: 0;

    color: #ffffff;
    background: #000000;

    border: none;
    border-radius: 999px;

    font-family: var(--font-body-family);
    font-size: 18px;
    line-height: 1.2;
    font-style: normal;
    font-weight: 400;
    letter-spacing: 0.01em;

    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;

    transition:
      background 0.25s ease,
      transform 0.25s ease;
  }

  #AerisHero-{{ section.id }} .aeris-hero__button:hover {
    background: #1a1a1a;
  }

  #AerisHero-{{ section.id }} .aeris-hero__arrow {
    position: absolute;
    z-index: 10;
    top: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 44px;
    height: 44px;

    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 50%;

    background: rgba(0, 0, 0, 0.25);
    color: #fff;

    font-family: var(--font-body-family);
    font-size: 34px;
    line-height: 1;

    cursor: pointer;

    transform: translateY(-50%);

    transition:
      background 0.2s ease,
      border-color 0.2s ease;
  }

  #AerisHero-{{ section.id }} .aeris-hero__arrow:hover {
    background: rgba(0, 0, 0, 0.55);
    border-color: rgba(255, 255, 255, 0.9);
  }

  #AerisHero-{{ section.id }} .aeris-hero__arrow--prev {
    left: 20px;
  }

  #AerisHero-{{ section.id }} .aeris-hero__arrow--next {
    right: 20px;
  }

  #AerisHero-{{ section.id }} .aeris-hero__dots {
    position: absolute;
    z-index: 10;

    left: 50%;
    bottom: 18px;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 10px;

    transform: translateX(-50%);
  }

  #AerisHero-{{ section.id }} .aeris-hero__dot {
    width: 9px;
    height: 9px;

    padding: 0;

    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 50%;

    background: transparent;

    cursor: pointer;

    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }

  #AerisHero-{{ section.id }} .aeris-hero__dot.is-active {
    background: #fff;
    transform: scale(1.15);
  }

  @media screen and (max-width: 989px) {
    #AerisHero-{{ section.id }} .aeris-hero__slider,
    #AerisHero-{{ section.id }} .aeris-hero__slide {
      min-height: {{ section.settings.tablet_height }}px;
    }

    #AerisHero-{{ section.id }} .aeris-hero__small-card {
      left: 24px;
      bottom: 24px;

      width: min({{ section.settings.small_image_width }}px, 230px);
    }

    #AerisHero-{{ section.id }} .aeris-hero__content {
      top: 50%;
      left: 50%;
      right: auto;
      bottom: auto;

      width: calc(100% - 48px);
      max-width: 36rem;

      transform: translate(-50%, -50%);
    }

    #AerisHero-{{ section.id }} .aeris-hero__heading {
      font-size: clamp(40px, 8vw, 64px);
      letter-spacing: 0.06em;
    }

    #AerisHero-{{ section.id }} .aeris-hero__subtitle {
      font-size: clamp(18px, 3.2vw, 24px);
    }
  }

  @media screen and (max-width: 749px) {
    #AerisHero-{{ section.id }} .aeris-hero__slider,
    #AerisHero-{{ section.id }} .aeris-hero__slide {
      min-height: {{ section.settings.mobile_height }}px;
    }

    #AerisHero-{{ section.id }} .aeris-hero__background-image {
      object-position: center center;
    }

    #AerisHero-{{ section.id }} .aeris-hero__small-card {
      left: {{ section.settings.mobile_small_image_left }}px;
      bottom: {{ section.settings.mobile_small_image_bottom }}px;

      width: {{ section.settings.mobile_small_image_width }}px;
      max-width: calc(100vw - 32px);
    }

    #AerisHero-{{ section.id }} .aeris-hero__content {
      top: 50%;
      left: 50%;
      right: auto;
      bottom: auto;

      width: calc(100% - 32px);
      max-width: calc(100vw - 32px);

      transform: translate(-50%, -50%);
    }

    #AerisHero-{{ section.id }} .aeris-hero__heading {
      font-size: clamp(36px, 11vw, 48px);
      line-height: 1;
      letter-spacing: 0.04em;
    }

    #AerisHero-{{ section.id }} .aeris-hero__subtitle {
      margin-top: 10px;

      font-size: clamp(16px, 4.6vw, 20px);
    }

    #AerisHero-{{ section.id }} .aeris-hero__button {
      margin-top: 16px;
      padding: 10px 22px;

      min-width: 0;

      font-size: 16px;
    }

    #AerisHero-{{ section.id }} .aeris-hero__arrow {
      width: 38px;
      height: 38px;

      font-size: 28px;
    }

    #AerisHero-{{ section.id }} .aeris-hero__arrow--prev {
      left: 10px;
    }

    #AerisHero-{{ section.id }} .aeris-hero__arrow--next {
      right: 10px;
    }

    #AerisHero-{{ section.id }} .aeris-hero__dots {
      bottom: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #AerisHero-{{ section.id }} .aeris-hero__slide,
    #AerisHero-{{ section.id }} .aeris-hero__button,
    #AerisHero-{{ section.id }} .aeris-hero__arrow,
    #AerisHero-{{ section.id }} .aeris-hero__dot {
      transition: none;
    }
  }
</style>

<script>
  (() => {
    const initAerisHero = () => {
      const section = document.getElementById('AerisHero-{{ section.id }}');

      if (!section || section.dataset.initialized === 'true') return;

      section.dataset.initialized = 'true';

      const slides = Array.from(
        section.querySelectorAll('.aeris-hero__slide')
      );

      const dots = Array.from(
        section.querySelectorAll('.aeris-hero__dot')
      );

      const nextButton = section.querySelector(
        '.aeris-hero__arrow--next'
      );

      const prevButton = section.querySelector(
        '.aeris-hero__arrow--prev'
      );

      if (slides.length === 0) return;

      let currentIndex = 0;
      let autoplayTimer = null;

      const autoplay = section.dataset.autoplay === 'true';
      const speed = Number(section.dataset.speed) || 5000;

      const showSlide = (index) => {
        currentIndex =
          (index + slides.length) % slides.length;

        slides.forEach((slide, slideIndex) => {
          slide.classList.toggle(
            'is-active',
            slideIndex === currentIndex
          );
        });

        dots.forEach((dot, dotIndex) => {
          dot.classList.toggle(
            'is-active',
            dotIndex === currentIndex
          );
        });
      };

      const nextSlide = () => {
        showSlide(currentIndex + 1);
      };

      const previousSlide = () => {
        showSlide(currentIndex - 1);
      };

      const stopAutoplay = () => {
        if (autoplayTimer) {
          clearInterval(autoplayTimer);
          autoplayTimer = null;
        }
      };

      const startAutoplay = () => {
        stopAutoplay();

        if (
          autoplay &&
          slides.length > 1 &&
          !window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          autoplayTimer = setInterval(
            nextSlide,
            speed
          );
        }
      };

      if (nextButton) {
        nextButton.addEventListener('click', () => {
          nextSlide();
          startAutoplay();
        });
      }

      if (prevButton) {
        prevButton.addEventListener('click', () => {
          previousSlide();
          startAutoplay();
        });
      }

      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
          showSlide(index);
          startAutoplay();
        });
      });

      section.addEventListener(
        'mouseenter',
        stopAutoplay
      );

      section.addEventListener(
        'mouseleave',
        startAutoplay
      );

      section.addEventListener(
        'focusin',
        stopAutoplay
      );

      section.addEventListener(
        'focusout',
        startAutoplay
      );

      let touchStartX = 0;
      let touchEndX = 0;

      section.addEventListener(
        'touchstart',
        (event) => {
          touchStartX =
            event.changedTouches[0].screenX;
        },
        { passive: true }
      );

      section.addEventListener(
        'touchend',
        (event) => {
          touchEndX =
            event.changedTouches[0].screenX;

          const difference =
            touchStartX - touchEndX;

          if (Math.abs(difference) < 50) return;

          if (difference > 0) {
            nextSlide();
          } else {
            previousSlide();
          }

          startAutoplay();
        },
        { passive: true }
      );

      showSlide(0);
      startAutoplay();
    };

    if (document.readyState === 'loading') {
      document.addEventListener(
        'DOMContentLoaded',
        initAerisHero
      );
    } else {
      initAerisHero();
    }

    document.addEventListener(
      'shopify:section:load',
      initAerisHero
    );
  })();
</script>
{% endif %}

{% schema %}
{
  "name": "Aeris Campaign Slider",
  "tag": "section",
  "class": "section-aeris-campaign-slider",
  "max_blocks": 8,

  "settings": [
    {
      "type": "header",
      "content": "Slideshow"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay slideshow",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Change slide every",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show slide dots",
      "default": true
    },

    {
      "type": "header",
      "content": "Hero size"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height",
      "min": 450,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 680
    },
    {
      "type": "range",
      "id": "tablet_height",
      "label": "Tablet height",
      "min": 450,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 450,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 650
    },

    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Background overlay",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 10
    },

    {
      "type": "header",
      "content": "Small image - Desktop"
    },
    {
      "type": "range",
      "id": "small_image_width",
      "label": "Small image width",
      "min": 180,
      "max": 450,
      "step": 10,
      "unit": "px",
      "default": 300
    },
    {
      "type": "range",
      "id": "small_image_left",
      "label": "Distance from left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "small_image_bottom",
      "label": "Distance from bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "small_image_ratio",
      "label": "Small image ratio",
      "default": "4 / 3",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 3",
          "label": "Landscape 4:3"
        },
        {
          "value": "3 / 2",
          "label": "Landscape 3:2"
        },
        {
          "value": "16 / 9",
          "label": "Landscape 16:9"
        },
        {
          "value": "4 / 5",
          "label": "Portrait 4:5"
        }
      ]
    },
    {
      "type": "range",
      "id": "small_image_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "small_image_border_width",
      "label": "Border width",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
