{%- liquid
  assign show_hero = false
  assign banner_image = blank
  assign banner_image_mobile = blank
  assign banner_title = blank

  case collection.handle
    when 'new-in', 'new-arrivals', 'new-arrival'
      assign show_hero = true
      assign banner_title = 'New Arrivals'
      assign banner_image = section.settings.arrivals_image
      assign banner_image_mobile = section.settings.arrivals_image_mobile
    when 'best-sellers-1', 'best-sellers', 'best-seller'
      assign show_hero = true
      assign banner_title = 'Best Sellers'
      assign banner_image = section.settings.arrivals_image
      assign banner_image_mobile = section.settings.arrivals_image_mobile
    when 'all', 'all-products', 'shop-all'
      assign show_hero = true
      assign banner_title = 'Shop All'
      assign banner_image = section.settings.arrivals_image
      assign banner_image_mobile = section.settings.arrivals_image_mobile
    when 'accessories', 'brushes-tools'
      assign show_hero = true
      assign banner_title = 'Brushes & Tools'
      assign banner_image = section.settings.accessories_image
      assign banner_image_mobile = section.settings.accessories_image_mobile
    when 'cleansers', 'brush-cleaner'
      assign show_hero = true
      assign banner_title = 'Brush Cleanser'
      assign banner_image = section.settings.cleansers_image
      assign banner_image_mobile = section.settings.cleansers_image_mobile
    when 'hair-tools'
      assign show_hero = true
      assign banner_title = 'Hair Tools'
      assign banner_image = section.settings.hair_image
      assign banner_image_mobile = section.settings.hair_image_mobile
    when 'wellness-tools', 'lifestyle-bags'
      assign show_hero = true
      assign banner_title = 'Lifestyle Bags'
      assign banner_image = section.settings.bags_image
      assign banner_image_mobile = section.settings.bags_image_mobile
    when 'gift-sets'
      assign show_hero = true
      assign banner_title = 'Bundles'
      assign banner_image = section.settings.bundles_image
      assign banner_image_mobile = section.settings.bundles_image_mobile
    when 'promo', 'promotion'
      assign show_hero = true
      assign banner_title = 'Promotion'
      assign banner_image = section.settings.promo_image
      assign banner_image_mobile = section.settings.promo_image_mobile
  endcase

  if banner_image == blank and collection.image != blank
    assign banner_image = collection.image
  endif
  if show_hero and banner_image == blank
    assign banner_image = section.settings.arrivals_image
    if banner_image_mobile == blank
      assign banner_image_mobile = section.settings.arrivals_image_mobile
    endif
  endif

  assign show_chips = false
  if collection.handle == 'brushes-tools' or collection.handle == 'accessories'
    assign show_chips = true
  endif
  if section.blocks.size == 0
    assign show_chips = false
  endif
-%}
{%- if show_hero -%}
  <section class="aeris-collection-hero" id="AerisCollectionHero-{{ section.id }}">
    <div class="aeris-collection-hero__banner">
      {% render 'aeris-banner-picture',
        image: banner_image,
        mobile_image: banner_image_mobile,
        alt: banner_title,
        image_class: 'aeris-collection-hero__image'
      %}
      {%- if banner_title != blank -%}
        <h1 class="aeris-collection-hero__title">{{ banner_title }}</h1>
      {%- endif -%}
    </div>

    {%- if show_chips -%}
      <div class="aeris-collection-hero__chips">
        <div class="container">
          <ul class="aeris-collection-hero__chip-list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'chip' -%}
                <li {{ block.shopify_attributes }}>
                  <a class="aeris-collection-hero__chip" href="{{ block.settings.link | default: collection.url }}">
                    <span class="aeris-collection-hero__chip-media">
                      {%- if block.settings.image != blank -%}
                        {{
                          block.settings.image
                          | image_url: width: 800
                          | image_tag:
                            loading: 'lazy',
                            widths: '240, 360, 540, 800',
                            sizes: '(min-width: 990px) 18vw, 40vw',
                            alt: block.settings.title,
                            class: 'aeris-collection-hero__chip-image'
                        }}
                      {%- endif -%}
                    </span>
                    {%- if block.settings.title != blank -%}
                      <span class="aeris-collection-hero__chip-label">
                        {{ block.settings.title }}
                        <svg width="14" height="15" fill="none" xmlns="http://www.w3.org/2000/svg" class="f-rlt-reverse-x" aria-hidden="true">
                          <path d="M2.188 7.75h9.624M7.875 3.813l3.938 3.937-3.938 3.938" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </span>
                    {%- endif -%}
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </div>
    {%- endif -%}
  </section>
    {%- endif -%}

  <style>
    #shopify-section-{{ section.id }} {
      padding: 0;
    }
    #shopify-section-{{ section.id }} .aeris-collection-hero__banner {
      position: relative;
      width: 100%;
      height: auto;
      aspect-ratio: 3 / 2;
      overflow: hidden;
      background: #f3f1ec;
      container-type: inline-size;
    }
    @media (min-width: 750px) {
      #shopify-section-{{ section.id }} .aeris-collection-hero__banner {
        aspect-ratio: 1440 / 340;
      }
    }
    #shopify-section-{{ section.id }} .aeris-collection-hero__image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      max-width: none;
      object-fit: cover;
      object-position: center center;
      display: block;
    }
    #shopify-section-{{ section.id }} .aeris-collection-hero__title {
      position: absolute;
      inset: 0;
      margin: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 2cqw;
      color: #fff;
      font-family: Montserrat, sans-serif;
      font-weight: 600;
      font-size: 3.61cqw;
      letter-spacing: 0.02em;
      line-height: 1;
      text-align: center;
      text-transform: uppercase;
      white-space: nowrap;
      text-shadow: 0 0.04em 0.35em rgba(0, 0, 0, 0.28);
    }
    .aeris-collection-hero__chips {
      padding: 2.4rem 0 2.4rem;
    }
    .aeris-collection-hero__chip-list {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.8rem;
      margin: 0;
      padding: 0;
    }
    .aeris-collection-hero__chip {
      position: relative;
      display: block;
      border-radius: 1.2rem;
      overflow: hidden;
      aspect-ratio: 4 / 3;
      background: #eceae4;
      text-decoration: none;
    }
    .aeris-collection-hero__chip-media {
      position: absolute;
      inset: 0;
      display: block;
      overflow: hidden;
      border-radius: inherit;
    }
    .aeris-collection-hero__chip-image {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
      border-radius: inherit;
    }
    .aeris-collection-hero__chip-label {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      padding: 6rem 1.6rem 1.8rem;
      background: linear-gradient(
        180deg,
        rgba(0, 0, 0, 0) 0%,
        rgba(0, 0, 0, 0.009) 12%,
        rgba(0, 0, 0, 0.034) 22%,
        rgba(0, 0, 0, 0.075) 32%,
        rgba(0, 0, 0, 0.13) 42%,
        rgba(0, 0, 0, 0.195) 52%,
        rgba(0, 0, 0, 0.26) 62%,
        rgba(0, 0, 0, 0.32) 72%,
        rgba(0, 0, 0, 0.365) 82%,
        rgba(0, 0, 0, 0.39) 91%,
        rgba(0, 0, 0, 0.4) 100%
      );
      color: #fff;
      font-family: var(--font-body-family);
      font-size: var(--font-h6-size);
      font-weight: var(--font-body-weight-bolder);
      line-height: 1.2;
      text-transform: uppercase;
      white-space: nowrap;
    }
    .aeris-collection-hero__chip-label svg {
      flex: none;
    }
    @media (min-width: 750px) {
      .aeris-collection-hero__chip-list {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
      }
      .aeris-collection-hero__chip-list > li {
        width: calc((100% - 3.2rem) / 5);
        flex: none;
      }
    }
  </style>

