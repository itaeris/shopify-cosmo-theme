{%- liquid
  assign show_hero = false
  assign banner_image = blank
  assign banner_title = collection.title
  assign show_title = true

  case collection.handle
    when 'accessories'
      assign show_hero = true
      assign banner_image = section.settings.accessories_image
      assign show_title = false
    when 'cleansers'
      assign show_hero = true
      assign banner_image = section.settings.cleansers_image
      assign banner_title = 'Brush Cleanser'
    when 'hair-tools'
      assign show_hero = true
      assign banner_image = section.settings.hair_image
      assign banner_title = 'Hair Tools'
    when 'wellness-tools'
      assign show_hero = true
      assign banner_image = section.settings.bags_image
      assign banner_title = 'Lifestyle Bags'
    when 'gift-sets'
      assign show_hero = true
      assign banner_image = section.settings.bundles_image
      assign banner_title = 'Bundles'
    when 'new-in', 'new-arrivals', 'new-arrival'
      assign show_hero = true
      assign banner_image = section.settings.arrivals_image
      assign banner_title = 'New Arrivals'
  endcase

  if banner_image == blank and collection.image != blank
    assign banner_image = collection.image
  endif
-%}
{%- if show_hero -%}
  <section class="aeris-collection-hero" id="AerisCollectionHero-{{ section.id }}">
    <div class="aeris-collection-hero__banner">
      {%- if banner_image != blank -%}
        {{
          banner_image
          | image_url: width: 3000
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '750, 1100, 1500, 2000, 2400, 3000',
            sizes: '100vw',
            alt: banner_title,
            class: 'aeris-collection-hero__image'
        }}
      {%- endif -%}
      {%- if show_title and banner_title != blank -%}
        <h1 class="aeris-collection-hero__title">{{ banner_title }}</h1>
      {%- endif -%}
    </div>

    {%- if collection.handle == 'accessories' and section.blocks.size > 0 -%}
      <div class="aeris-collection-hero__chips">
        <div class="container">
          <ul class="aeris-collection-hero__chip-list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'chip' -%}
                <li {{ block.shopify_attributes }}>
                  <a class="aeris-collection-hero__chip" href="{{ block.settings.link | default: collection.url }}">
                    <span class="aeris-collection-hero__chip-media">
                      {%- if block.settings.image != blank -%}
                        {{
                          block.settings.image
                          | image_url: width: 800
                          | image_tag:
                            loading: 'lazy',
                            widths: '240, 360, 540, 800',
                            sizes: '(min-width: 990px) 18vw, 40vw',
                            alt: block.settings.title,
                            class: 'aeris-collection-hero__chip-image'
                        }}
                      {%- endif -%}
                    </span>
                    {%- if block.settings.title != blank -%}
                      <span class="aeris-collection-hero__chip-label">{{ block.settings.title }}</span>
                    {%- endif -%}
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </div>
    {%- endif -%}
  </section>

  <style>
    #shopify-section-{{ section.id }} {
      padding: 0;
    }
    .aeris-collection-hero__banner {
      position: relative;
      width: 100%;
      height: 200px;
      overflow: hidden;
      background: #f3f1ec;
    }
    .aeris-collection-hero__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }
    .aeris-collection-hero__title {
      position: absolute;
      inset: 0;
      margin: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 1.6rem;
      color: #fff;
      font-family: Newsreader, Georgia, serif;
      font-weight: 400;
      font-size: clamp(2.8rem, 4.2vw, 5.2rem);
      letter-spacing: 0.16em;
      line-height: 1;
      text-align: center;
      text-transform: uppercase;
      text-shadow: 0 2px 18px rgba(0, 0, 0, 0.28);
    }
    .aeris-collection-hero__chips {
      padding: 2.4rem 0 0.8rem;
    }
    .aeris-collection-hero__chip-list {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.2rem;
      margin: 0;
      padding: 0;
    }
    .aeris-collection-hero__chip {
      position: relative;
      display: block;
      border-radius: 1.6rem;
      overflow: hidden;
      aspect-ratio: 1 / 1.05;
      background: #eceae4;
      text-decoration: none;
    }
    .aeris-collection-hero__chip-media,
    .aeris-collection-hero__chip-image {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }
    .aeris-collection-hero__chip-label {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      background: #fff;
      color: #222;
      border-radius: 999px;
      padding: 0.7rem 1.4rem;
      font-family: Montserrat, sans-serif;
      font-size: 1.1rem;
      font-weight: 500;
      letter-spacing: 0.08em;
      line-height: 1;
      text-transform: uppercase;
      white-space: nowrap;
    }
    @media (min-width: 750px) {
      .aeris-collection-hero__banner {
        height: 280px;
      }
      .aeris-collection-hero__chip-list {
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 1.6rem;
      }
      .aeris-collection-hero__chip {
        border-radius: 1.8rem;
      }
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Aeris collection hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "accessories_image",
      "label": "Brushes & Tools banner"
    },
    {
      "type": "image_picker",
      "id": "cleansers_image",
      "label": "Brush Cleanser banner"
    },
    {
      "type": "image_picker",
      "id": "hair_image",
      "label": "Hair Tools banner"
    },
    {
      "type": "image_picker",
      "id": "bags_image",
      "label": "Lifestyle Bags banner"
    },
    {
      "type": "image_picker",
      "id": "bundles_image",
      "label": "Bundles banner"
    },
    {
      "type": "image_picker",
      "id": "arrivals_image",
      "label": "New Arrivals banner"
    }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Brushes category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "All"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aeris collection hero"
    }
  ]
}
{% endschema %}
