{%- liquid
  assign banner_title = section.settings.title
  assign banner_image = section.settings.image
  assign banner_image_mobile = section.settings.image_mobile
-%}
<section class="aeris-collection-hero" id="AerisPageBanner-{{ section.id }}">
  <div class="aeris-collection-hero__banner">
    {% render 'aeris-banner-picture',
      image: banner_image,
      mobile_image: banner_image_mobile,
      alt: banner_title,
      image_class: 'aeris-collection-hero__image'
    %}
    {%- if banner_title != blank -%}
      <h1 class="aeris-collection-hero__title">{{ banner_title }}</h1>
    {%- endif -%}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} {
    padding: 0;
  }
  #shopify-section-{{ section.id }} .aeris-collection-hero__banner {
    position: relative;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: #f3f1ec;
    container-type: inline-size;
  }
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .aeris-collection-hero__banner {
      aspect-ratio: 1440 / 340;
    }
  }
  #shopify-section-{{ section.id }} .aeris-collection-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center center;
    display: block;
  }
  #shopify-section-{{ section.id }} .aeris-collection-hero__title {
    position: absolute;
    inset: 0;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 2cqw;
    color: #fff;
    font-family: Newsreader, Georgia, serif;
    font-weight: 400;
    font-size: 3.61cqw;
    letter-spacing: 0.16em;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    text-shadow: 0 0.04em 0.35em rgba(0, 0, 0, 0.28);
  }
</style>

{% schema %}
{
  "name": "Aeris page banner",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Promotion"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner, desktop",
      "info": "2880 × 680 px."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Banner, HP",
      "info": "1500 × 1000 px. Kosongkan untuk memakai foto desktop."
    }
  ],
  "presets": [
    {
      "name": "Aeris page banner"
    }
  ]
}
{% endschema %}
