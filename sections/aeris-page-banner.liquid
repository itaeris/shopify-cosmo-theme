{%- liquid
  assign banner_title = section.settings.title
  assign banner_image = section.settings.image
-%}
<section class="aeris-collection-hero" id="AerisPageBanner-{{ section.id }}">
  <div class="aeris-collection-hero__banner">
    {%- if banner_image != blank -%}
      {{
        banner_image
        | image_url: width: 3000
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750, 1100, 1500, 2000, 2400, 3000',
          sizes: '100vw',
          alt: banner_title,
          class: 'aeris-collection-hero__image'
      }}
    {%- endif -%}
    {%- if banner_title != blank -%}
      <h1 class="aeris-collection-hero__title">{{ banner_title }}</h1>
    {%- endif -%}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} {
    padding: 0;
  }
  #shopify-section-{{ section.id }} .aeris-collection-hero__banner {
    position: relative;
    width: 100%;
    height: auto;
    aspect-ratio: 1440 / 340;
    overflow: hidden;
    background: #f3f1ec;
    container-type: inline-size;
  }
  #shopify-section-{{ section.id }} .aeris-collection-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center center;
    display: block;
  }
  #shopify-section-{{ section.id }} .aeris-collection-hero__title {
    position: absolute;
    inset: 0;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 2cqw;
    color: #fff;
    font-family: Newsreader, Georgia, serif;
    font-weight: 400;
    font-size: 3.61cqw;
    letter-spacing: 0.16em;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    text-shadow: 0 0.04em 0.35em rgba(0, 0, 0, 0.28);
  }
</style>

{% schema %}
{
  "name": "Aeris page banner",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Promotion"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image"
    }
  ],
  "presets": [
    {
      "name": "Aeris page banner"
    }
  ]
}
{% endschema %}
