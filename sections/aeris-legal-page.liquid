{%- liquid
  assign document = section.settings.document | default: 'terms'
  assign page_title = section.settings.heading | default: page.title
  if page_title == blank
    if document == 'privacy'
      assign page_title = 'Privacy Policy'
    else
      assign page_title = 'Terms of Service'
    endif
  endif
-%}

{{ 'aeris-legal.css' | asset_url | stylesheet_tag }}
<section
  id="AerisLegal-{{ section.id }}"
  class="aeris-legal aeris-legal--{{ document }}"
>
  <div class="aeris-legal__wrapper">
    <aside class="aeris-legal__media">
      <div class="aeris-legal__image-wrap">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              loading: 'eager',
              widths: '400, 600, 800, 1100, 1400',
              sizes: '(max-width: 749px) 100vw, 38vw',
              class: 'aeris-legal__image'
          }}
        {% else %}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'aeris-legal__image aeris-legal__placeholder' }}
        {% endif %}
      </div>
      <h1 class="aeris-legal__title">{{ page_title }}</h1>
    </aside>

    <div class="aeris-legal__content">
      {% if document == 'privacy' %}
        {% render 'aeris-legal-privacy' %}
      {% else %}
        {% render 'aeris-legal-terms' %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Aeris Legal Page",
  "settings": [
    {
      "type": "select",
      "id": "document",
      "label": "Document",
      "options": [
        { "value": "terms", "label": "Terms of Service" },
        { "value": "privacy", "label": "Privacy Policy" }
      ],
      "default": "terms"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "Terms of Service"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Side image"
    }
  ],
  "presets": [
    {
      "name": "Aeris Legal Page"
    }
  ]
}
{% endschema %}
