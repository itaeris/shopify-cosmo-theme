  </div>
</section>

<script src="{{ 'aeris-store-locations.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Store locations",
  "tag": "section",
  "class": "aeris-store-locations-section",
  "settings": [
    {
      "type": "header",
      "content": "Store images"
    },
    {
      "type": "paragraph",
      "content": "Upload a photo for each store. An empty slot shows a placeholder."
    },
    {
      "type": "image_picker",
      "id": "image_pakuwon",
      "label": "Pakuwon Mall Surabaya"
    },
    {
      "type": "image_picker",
      "id": "image_paskal",
      "label": "23 Paskal Bandung"
    },
    {
      "type": "image_picker",
      "id": "image_living_world",
      "label": "Living World Denpasar"
    },
    {
      "type": "image_picker",
      "id": "image_trans_studio",
      "label": "Trans Studio Mall Makassar"
    },
    {
      "type": "image_picker",
      "id": "image_dp_mall",
      "label": "DP Mall Semarang"
    }
  ],
  "presets": [
    {
      "name": "Store locations"
    }
  ]
}
{% endschema %}
