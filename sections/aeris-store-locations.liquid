{{ 'aeris-store-locations.css' | asset_url | stylesheet_tag }}

<section class="aeris-stores" data-aeris-stores>
  <div class="aeris-stores__breadcrumb">
    <div class="container">
      <nav class="breadcrumbs flex justify-center" role="navigation" aria-label="breadcrumbs">
        <a href="{{ routes.root_url }}" title="Home">Home</a>
        <span aria-hidden="true" class="breadcrumbs--sep">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M4.5 2.25L8.25 6L4.5 9.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="breadcrumbs--last">Store Locations</span>
      </nav>
    </div>
  </div>

  <div class="aeris-stores__layout container">
    <div class="aeris-stores__toolbar">
      <label class="aeris-stores__field">
        <span class="aeris-stores__label">Location</span>
        <select class="aeris-stores__select" data-store-filter aria-label="Location">
          <option value="all">ALL</option>
          <option value="pakuwon">Pakuwon Mall Surabaya</option>
          <option value="paskal">23 Paskal Bandung</option>
          <option value="living-world">Living World Denpasar</option>
          <option value="trans-studio">Trans Studio Mall Makassar</option>
          <option value="dp-mall">DP Mall Semarang</option>
        </select>
      </label>
      <p class="aeris-stores__count">Search results: <span data-store-count>5</span></p>
    </div>

    <div class="aeris-stores__row" data-store="pakuwon" id="pakuwon">
      <article class="aeris-stores__card">
        <div class="aeris-stores__photo">
          {%- if section.settings.image_pakuwon != blank -%}
            {{
              section.settings.image_pakuwon
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '400, 700, 1000, 1200',
                sizes: '(min-width: 990px) 34rem, 100vw',
                class: 'aeris-stores__photo-image',
                alt: 'Pakuwon Mall Surabaya'
            }}
          {%- else -%}
            <div class="aeris-stores__photo-placeholder">
              {{ 'image' | placeholder_svg_tag: 'aeris-stores__photo-svg' }}
              <span>Add store image</span>
            </div>
          {%- endif -%}
        </div>
        <h2>Pakuwon Mall Surabaya</h2>
        <p>1st Floor</p>
        <a href="https://maps.app.goo.gl/nhRCmUkAZh7Vcz6T6" target="_blank" rel="noopener">Get directions</a>
      </article>
      <div class="aeris-stores__map">
        <iframe
          title="Pakuwon Mall Surabaya"
          src="https://maps.google.com/maps?q=-7.2893106,112.6756551&hl=en&z=16&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
    <div class="aeris-stores__row" data-store="paskal" id="paskal">
      <article class="aeris-stores__card">
        <div class="aeris-stores__photo">
          {%- if section.settings.image_paskal != blank -%}
