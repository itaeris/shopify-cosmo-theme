{%- liquid
  assign hero_block = section.blocks.first
  assign hero_product = hero_block.settings.product
  assign hero_title = section.settings.banner_title
  if hero_title == blank and hero_block != blank
    assign hero_title = hero_block.settings.title
  endif
  assign hero_subtitle = section.settings.hero_subtitle
  if hero_subtitle == blank and hero_block != blank
    assign hero_subtitle = hero_block.settings.subtitle
  endif
  assign hero_text = section.settings.hero_text
  assign hero_url = hero_block.settings.link | default: hero_product.url
  assign hero_image = section.settings.banner_image
  if hero_image == blank and hero_product != blank
    assign hero_image = hero_product.featured_image
  endif
  assign single_product = blank
  for block in section.blocks offset: 1
    if block.settings.product != blank
      assign single_product = block.settings.product
      break
    endif
  endfor
  assign shown = 0
-%}

<section
  id="AerisOnyx-{{ section.id }}"
  class="aeris-onyx"
>
  <div class="aeris-onyx__slider" data-onyx-slider>
    <div class="aeris-onyx__track" data-onyx-track>
      {%- if hero_image != blank and shown < 4 -%}
        <div class="aeris-onyx__slide" data-onyx-slide>
          <a class="aeris-onyx__slide-link" href="{{ hero_url | default: '#' }}">
            {{
              hero_image
              | image_url: width: 2400
              | image_tag:
                loading: 'eager',
                widths: '800, 1200, 1600, 2000, 2400',
                sizes: '100vw',
                class: 'aeris-onyx__slide-image',
                alt: hero_title
            }}
          </a>
        </div>
        {%- assign shown = shown | plus: 1 -%}
      {%- endif -%}

      {%- if hero_product.featured_image != blank and hero_product.featured_image.src != hero_image.src and shown < 4 -%}
        <div class="aeris-onyx__slide" data-onyx-slide>
          <a class="aeris-onyx__slide-link" href="{{ hero_product.url }}">
            {{
              hero_product.featured_image
              | image_url: width: 2400
              | image_tag:
                loading: 'lazy',
                widths: '800, 1200, 1600, 2000, 2400',
                sizes: '100vw',
                class: 'aeris-onyx__slide-image',
                alt: hero_product.title
            }}
          </a>
        </div>
        {%- assign shown = shown | plus: 1 -%}
      {%- endif -%}

      {%- if single_product != blank -%}
        {%- for image in single_product.images -%}
          {%- if shown >= 4 -%}
            {%- break -%}
          {%- endif -%}
          <div class="aeris-onyx__slide" data-onyx-slide>
            <a class="aeris-onyx__slide-link" href="{{ single_product.url }}">
              {{
                image
                | image_url: width: 2400
                | image_tag:
                  loading: 'lazy',
                  widths: '800, 1200, 1600, 2000, 2400',
                  sizes: '100vw',
                  class: 'aeris-onyx__slide-image',
                  alt: single_product.title
              }}
            </a>
          </div>
          {%- assign shown = shown | plus: 1 -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="aeris-onyx__products color-background-1">
      <div class="container">
        <div class="f-grid f-grid-2-cols md:f-grid-4-cols lg:f-grid-4-cols f-grid--gap-medium f-grid--row-gap-medium">
          {%- for block in section.blocks -%}
            {%- if block.settings.product == blank -%}
              {%- continue -%}
            {%- endif -%}
            <div class="f-column" {{ block.shopify_attributes }}>
              {% render 'product-card',
                product: block.settings.product,
                show_vendor: false,
                section_index: section.index,
                index: forloop.index
              %}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</section>

<script>
  (() => {
    const root = document.getElementById('AerisOnyx-{{ section.id }}');
    if (!root || root.dataset.onyxReady === 'true') return;
    const slider = root.querySelector('[data-onyx-slider]');
    const track = root.querySelector('[data-onyx-track]');
    const slides = [...root.querySelectorAll('[data-onyx-slide]')];
    if (!slider || !track || slides.length < 2) return;
    root.dataset.onyxReady = 'true';

    let index = 0;
    let timer = 0;
    const delay = 2800;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const go = (next) => {
      index = (next + slides.length) % slides.length;
      track.style.transform = 'translate3d(' + (-index * slider.clientWidth) + 'px, 0, 0)';
    };

    const play = () => {
      if (reduced) return;
      window.clearInterval(timer);
      timer = window.setInterval(() => go(index + 1), delay);
    };

    const stop = () => window.clearInterval(timer);

    slider.addEventListener('mouseenter', stop);
    slider.addEventListener('mouseleave', play);
    window.addEventListener('resize', () => go(index));

    let startX = 0;
    slider.addEventListener('touchstart', (event) => {
      startX = event.changedTouches[0].clientX;
      stop();
    }, { passive: true });
    slider.addEventListener('touchend', (event) => {
      const delta = event.changedTouches[0].clientX - startX;
      if (Math.abs(delta) > 40) go(index + (delta < 0 ? 1 : -1));
      play();
    }, { passive: true });

    go(0);
    play();
  })();
</script>

<style>
  #AerisOnyx-{{ section.id }} {
    background: #fff;
    color: #1c1c1c;
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__slider {
    position: relative;
    overflow: hidden;
    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    background: #f6f3ee;
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__track {
    display: flex;
    align-items: stretch;
    transition: transform 0.6s ease;
    will-change: transform;
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__slide {
    position: relative;
    flex: 0 0 100%;
    width: 100%;
    min-height: 0;
    height: clamp(28rem, 42vw, 52rem);
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__slide-link,
  #AerisOnyx-{{ section.id }} .aeris-onyx__slide-media {
    display: block;
    width: 100%;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__slide-image {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__products {
    width: 100%;
    padding: 3.2rem 0 6.4rem;
  }

  @media (prefers-reduced-motion: reduce) {
    #AerisOnyx-{{ section.id }} .aeris-onyx__track {
      transition: none;
    }
  }
</style>

{% schema %}
{
  "name": "Onyx collection",
  "tag": "section",
  "class": "aeris-onyx-section",
  "settings": [
    {
      "type": "text",
      "id": "banner_title",
      "label": "Banner title",
      "default": "The Onyx 2.0 Collection"
    },
    {
      "type": "text",
      "id": "hero_subtitle",
      "label": "Banner subtitle",
      "default": "Complete Set"
    },
    {
      "type": "text",
      "id": "hero_text",
      "label": "Banner description",
      "default": "Our best selling brush for everyday use"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner image",
      "info": "Leave empty to use the first product image."
    },
    {
      "type": "text",
      "id": "grid_heading",
      "label": "Product heading",
      "default": "The Onyx 2.0 Collection"
    },
    {
      "type": "text",
      "id": "atc_label",
      "label": "Add to bag label",
      "default": "ADD TO BAG"
    },
    {
      "type": "text",
      "id": "learn_more_label",
      "label": "Learn more label",
      "default": "LEARN MORE"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image",
          "info": "Leave empty to use a product photo."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Short description"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Onyx collection",
      "blocks": [
        {
          "type": "feature"
        },
        {
          "type": "feature"
        }
      ]
    }
  ]
}
{% endschema %}
