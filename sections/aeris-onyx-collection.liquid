{%- liquid
  assign hero_block = section.blocks.first
  assign hero_product = hero_block.settings.product
  assign hero_variant = hero_product.selected_or_first_available_variant
  assign hero_title = section.settings.banner_title
  if hero_title == blank and hero_block != blank
    assign hero_title = hero_block.settings.title
  endif
  assign hero_subtitle = section.settings.hero_subtitle
  if hero_subtitle == blank and hero_block != blank
    assign hero_subtitle = hero_block.settings.subtitle
  endif
  assign hero_text = section.settings.hero_text
  assign hero_url = hero_block.settings.link | default: hero_product.url
  assign hero_form_id = 'AerisOnyxForm-' | append: section.id
-%}

<section
  id="AerisOnyx-{{ section.id }}"
  class="aeris-onyx"
>
  <div class="aeris-onyx__stage">
    {%- if hero_title != blank -%}
      <h2 class="aeris-onyx__banner-title">{{ hero_title }}</h2>
    {%- endif -%}

    {%- if hero_product.images.size > 0 -%}
      <div class="aeris-onyx__carousel" data-onyx-carousel>
        {%- if hero_product.images.size > 1 -%}
          <button type="button" class="aeris-onyx__arrow aeris-onyx__arrow--prev" data-onyx-prev aria-label="Previous">
            <span aria-hidden="true">‹</span>
          </button>
        {%- endif -%}
        <div class="aeris-onyx__viewport">
          <div class="aeris-onyx__track" data-onyx-track>
            {%- for image in hero_product.images limit: 6 -%}
              <div class="aeris-onyx__slide">
                {{
                  image
                  | image_url: width: 1400
                  | image_tag:
                    loading: 'lazy',
                    widths: '500, 800, 1100, 1400',
                    sizes: '(min-width: 750px) 48rem, 86vw',
                    class: 'aeris-onyx__slide-image',
                    alt: hero_title
                }}
              </div>
            {%- endfor -%}
          </div>
        </div>
        {%- if hero_product.images.size > 1 -%}
          <button type="button" class="aeris-onyx__arrow aeris-onyx__arrow--next" data-onyx-next aria-label="Next">
            <span aria-hidden="true">›</span>
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if hero_product != blank or hero_subtitle != blank or hero_text != blank -%}
      <div class="aeris-onyx__banner-card">
        {%- if hero_title != blank -%}
          <p class="aeris-onyx__card-title">{{ hero_title }}</p>
        {%- endif -%}
        {%- if hero_subtitle != blank -%}
          <p class="aeris-onyx__card-subtitle">{{ hero_subtitle }}</p>
        {%- endif -%}
        {%- if hero_text != blank -%}
          <p class="aeris-onyx__card-text">{{ hero_text }}</p>
        {%- endif -%}

        {%- if hero_product != blank -%}
          <product-form class="aeris-onyx__form" data-notification-type="toast">
            {%- form 'product',
              hero_product,
              id: hero_form_id,
              class: 'aeris-onyx__product-form',
              novalidate: 'novalidate',
              data-type: 'add-to-cart-form'
            -%}
              <input type="hidden" name="id" value="{{ hero_variant.id }}" disabled>
              <div class="aeris-onyx__atc">
                <button
                  type="submit"
                  name="add"
                  class="aeris-onyx__atc-btn"
                  {% unless hero_variant.available %}
                    disabled
                  {% endunless %}
                >
                  <span>
                    {%- if hero_variant.available -%}
                      {{ section.settings.atc_label }}
                    {%- else -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- endif -%}
                  </span>
                </button>
                <span class="aeris-onyx__atc-price">
                  {%- if hero_product.price_varies -%}
                    Rp {{ hero_product.price_min | money }}
                  {%- else -%}
                    Rp {{ hero_variant.price | money }}
                  {%- endif -%}
                </span>
              </div>
            {%- endform -%}
          </product-form>

          {%- if section.settings.learn_more_label != blank and hero_url != blank -%}
            <a class="aeris-onyx__learn" href="{{ hero_url }}">
              {{ section.settings.learn_more_label }}
              <span aria-hidden="true">→</span>
            </a>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <script>
    (function () {
      var root = document.getElementById('AerisOnyx-{{ section.id }}');
      if (!root) return;
      var track = root.querySelector('[data-onyx-track]');
      if (!track) return;
      var slides = track.children;
      var index = 0;
      function go(next) {
        if (!slides.length) return;
        index = (next + slides.length) % slides.length;
        track.style.transform = 'translateX(' + index * -100 + '%)';
      }
      var prev = root.querySelector('[data-onyx-prev]');
      var next = root.querySelector('[data-onyx-next]');
      if (prev) prev.addEventListener('click', function () { go(index - 1); });
      if (next) next.addEventListener('click', function () { go(index + 1); });
    })();
  </script>

  {%- if section.blocks.size > 0 -%}
    <div class="aeris-onyx__products">
      {%- if section.settings.grid_heading != blank -%}
        <h2 class="aeris-onyx__grid-heading">{{ section.settings.grid_heading }}</h2>
      {%- endif -%}
      <div class="aeris-onyx__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign product = block.settings.product
            if product == blank
              continue
            endif
            assign card_image = block.settings.image
            if card_image == blank
              if forloop.first
                assign card_image = product.images[4] | default: product.featured_image
              else
                assign card_image = hero_product.images[2] | default: product.featured_image
              endif
            endif
            assign card_title = block.settings.title | default: product.title
            assign card_text = block.settings.subtitle
            assign card_url = block.settings.link | default: product.url
          -%}
          <article class="aeris-onyx__item" {{ block.shopify_attributes }}>
            <a class="aeris-onyx__item-media" href="{{ card_url }}">
              {%- if card_image != blank -%}
                {{
                  card_image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '400, 700, 1000, 1200',
                    sizes: '(min-width: 750px) 40vw, 90vw',
                    class: 'aeris-onyx__item-image',
                    alt: card_title
                }}
              {%- endif -%}
            </a>
            <div class="aeris-onyx__item-copy">
              <h3 class="aeris-onyx__item-title">
                <a href="{{ card_url }}">{{ card_title }}</a>
              </h3>
              {%- if card_text != blank -%}
                <p class="aeris-onyx__item-text">{{ card_text }}</p>
              {%- endif -%}
              <p class="aeris-onyx__item-price">
                {%- if product.price_varies -%}
                  Start from Rp {{ product.price_min | money }}
                {%- else -%}
                  Rp {{ product.price | money }}
                {%- endif -%}
              </p>
            </div>
          </article>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

<style>
  #AerisOnyx-{{ section.id }} {
    background: #fff;
    color: #1c1c1c;
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 4rem 2rem 4.4rem;
    background: #f6f1ea;
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__carousel {
    position: relative;
    width: min(100%, 92rem);
    margin-top: 2.4rem;
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__viewport {
    overflow: hidden;
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__track {
    display: flex;
    transition: transform 0.45s ease;
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__slide {
    flex: 0 0 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 32rem;
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__slide-image {
    width: auto;
    max-width: min(48rem, 78%);
    height: 32rem;
    max-height: 32rem;
    object-fit: contain;
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #fff;
    color: #1c1c1c;
    font-size: 2.8rem;
    line-height: 1;
    transform: translateY(-50%);
    cursor: pointer;
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__arrow--prev { left: 0; }
  #AerisOnyx-{{ section.id }} .aeris-onyx__arrow--next { right: 0; }

  #AerisOnyx-{{ section.id }} .aeris-onyx__banner-title {
    margin: 0;
    color: #2a2420;
    font-family: var(--font-heading-family);
    font-size: clamp(2.8rem, 4vw, 4.2rem);
    font-weight: 400;
    line-height: 1.15;
    text-align: center;
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__banner-card {
    width: min(100%, 36rem);
    margin-top: 1.6rem;
    padding: 0;
    background: transparent;
    text-align: center;
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__card-title,
  #AerisOnyx-{{ section.id }} .aeris-onyx__card-subtitle,
  #AerisOnyx-{{ section.id }} .aeris-onyx__card-text {
    margin: 0;
    font-family: var(--font-heading-family);
    font-weight: 400;
    line-height: 1.35;
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__card-title {
    font-size: clamp(1.8rem, 2vw, 2.4rem);
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__card-subtitle,
  #AerisOnyx-{{ section.id }} .aeris-onyx__card-text {
    font-size: 1.45rem;
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__form,
  #AerisOnyx-{{ section.id }} .aeris-onyx__product-form {
    display: block;
    margin-top: 1.6rem;
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__atc {
    display: grid;
    grid-template-columns: 1fr 1fr;
    max-width: 32rem;
    margin: 0 auto;
    overflow: hidden;
    border: 1px solid #1c1c1c;
    border-radius: 999px;
    background: #fff;
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__atc-btn,
  #AerisOnyx-{{ section.id }} .aeris-onyx__atc-price {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 3.8rem;
    margin: 0;
    padding: 0.7rem 1rem;
    border: 0;
    background: transparent;
    color: #1c1c1c;
    font-family: var(--font-body-family);
    font-size: 1.1rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__atc-btn {
    cursor: pointer;
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__atc-btn:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__atc-price {
    border-left: 1px solid #1c1c1c;
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__learn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.2rem;
    color: #1c1c1c;
    font-family: var(--font-body-family);
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__products {
    width: min(1120px, calc(100% - 4.8rem));
    margin: 0 auto;
    padding: 4.8rem 0 6.4rem;
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__grid-heading {
    margin: 0 0 2.4rem;
    color: #1c1c1c;
    font-family: var(--font-body-family);
    font-size: 1.6rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.8rem;
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__item-media {
    display: block;
    background: #f4f1ec;
    aspect-ratio: 1 / 1.05;
    overflow: hidden;
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__item-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__item-copy {
    padding-top: 1.4rem;
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__item-title {
    margin: 0;
    font-family: var(--font-body-family);
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__item-title a {
    color: inherit;
    text-decoration: none;
  }

  #AerisOnyx-{{ section.id }} .aeris-onyx__item-text,
  #AerisOnyx-{{ section.id }} .aeris-onyx__item-price {
    margin: 0.3rem 0 0;
    color: #3a3a3a;
    font-size: 1.4rem;
    line-height: 1.45;
  }

  @media (min-width: 750px) {
    #AerisOnyx-{{ section.id }} .aeris-onyx__stage {
      padding: 5.2rem 3rem 5.6rem;
    }

    #AerisOnyx-{{ section.id }} .aeris-onyx__slide,
    #AerisOnyx-{{ section.id }} .aeris-onyx__slide-image {
      height: 42rem;
    }

    #AerisOnyx-{{ section.id }} .aeris-onyx__slide {
      min-height: 42rem;
    }

    #AerisOnyx-{{ section.id }} .aeris-onyx__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.4rem;
    }
  }
</style>

{% schema %}
{
  "name": "Onyx collection",
  "tag": "section",
  "class": "aeris-onyx-section",
  "settings": [
    {
      "type": "text",
      "id": "banner_title",
      "label": "Banner title",
      "default": "The Onyx 2.0 Collection"
    },
    {
      "type": "text",
      "id": "hero_subtitle",
      "label": "Banner subtitle",
      "default": "Complete Set"
    },
    {
      "type": "text",
      "id": "hero_text",
      "label": "Banner description",
      "default": "Our best selling brush for everyday use"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner image",
      "info": "Leave empty to use the first product image."
    },
    {
      "type": "text",
      "id": "grid_heading",
      "label": "Product heading",
      "default": "The Onyx 2.0 Collection"
    },
    {
      "type": "text",
      "id": "atc_label",
      "label": "Add to bag label",
      "default": "ADD TO BAG"
    },
    {
      "type": "text",
      "id": "learn_more_label",
      "label": "Learn more label",
      "default": "LEARN MORE"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image",
          "info": "Leave empty to use a product photo."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Short description"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Onyx collection",
      "blocks": [
        {
          "type": "feature"
        },
        {
          "type": "feature"
        }
      ]
    }
  ]
}
{% endschema %}
