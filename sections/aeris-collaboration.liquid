<section class="aeris-collab">
  <div class="aeris-collab__wrap">
    {%- if section.settings.heading != blank -%}
      <h1 class="aeris-collab__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <div class="aeris-collab__intro">{{ section.settings.intro }}</div>
    {%- endif -%}

    <div class="aeris-collab__grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <article class="aeris-collab__card" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a class="aeris-collab__link" href="{{ block.settings.link }}">
            {%- endif -%}
            <div class="aeris-collab__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1400
                  | image_tag:
                    alt: block.settings.title,
                    widths: '400, 700, 1000, 1400',
                    sizes: '(min-width: 750px) 50vw, 100vw',
                    class: 'aeris-collab__image'
                }}
              {%- endif -%}
            </div>
            {%- if block.settings.label != blank -%}
              <p class="aeris-collab__label">{{ block.settings.label }}</p>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h2 class="aeris-collab__title">{{ block.settings.title }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="aeris-collab__text">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.link != blank -%}
              </a>
            {%- endif -%}
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
  .aeris-collab {
    padding: 4.8rem 0 8rem;
    color: #1c1c1c;
    background: #fff;
  }
  .aeris-collab__wrap {
    width: min(1120px, calc(100% - 4rem));
    margin: 0 auto;
  }
  .aeris-collab__heading {
    margin: 0 0 1.6rem;
    font-family: Montserrat, sans-serif;
    font-weight: 600;
    font-size: 2.8rem;
    line-height: 1.25;
    letter-spacing: 0;
    text-transform: none;
  }
  .aeris-collab__intro {
    margin: 0 0 3.2rem;
    max-width: 72rem;
    font-family: Montserrat, sans-serif;
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.55;
    color: #2a2a2a;
  }
  .aeris-collab__intro p {
    margin: 0;
  }
  .aeris-collab__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.2rem;
  }
  .aeris-collab__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .aeris-collab__media {
    aspect-ratio: 3 / 2;
    margin-bottom: 1.6rem;
    background: #f3f1ec;
    overflow: hidden;
  }
  .aeris-collab__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .aeris-collab__label {
    margin: 0 0 0.6rem;
    font-family: Montserrat, sans-serif;
    font-size: 1.4rem;
    font-weight: 400;
    line-height: 1.4;
  }
  .aeris-collab__title {
    margin: 0 0 0.8rem;
    font-family: Montserrat, sans-serif;
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0;
    text-transform: none;
  }
  .aeris-collab__text {
    font-family: Montserrat, sans-serif;
    font-size: 1.4rem;
    font-weight: 400;
    line-height: 1.55;
    color: #1c1c1c;
  }
  .aeris-collab__text p {
    margin: 0;
  }
  @media (min-width: 750px) {
    .aeris-collab__heading {
      font-size: 3.2rem;
    }
    .aeris-collab__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.4rem 2.8rem;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Aeris Collaboration",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Judul",
      "default": "Collaboration"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Pengantar",
      "default": "<p>Aeris Beauté partners with makeup artists and creators who care about tools that are vegan, cruelty-free, and made for everyday use. Each collaboration is practical, personal, and built to last.</p>"
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Cerita",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Gambar"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Aeris"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Judul",
          "default": "Judul cerita"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Teks",
          "default": "<p>Tulis cerita kolaborasi di sini.</p>"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Tautan"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Aeris Collaboration",
      "blocks": [
        {
          "type": "story",
          "settings": {
            "label": "Artists",
            "title": "Aeris Circle for artists",
            "text": "<p>For professional makeup artists, beauty students, and studios. Work with Aeris on the brushes and bags you use with clients, and stay close to the team through events and masterclasses.</p>"
          }
        },
        {
          "type": "story",
          "settings": {
            "label": "Creators",
            "title": "Aeris Circle for creators",
            "text": "<p>For makeup lovers and content creators. Share Aeris in your routine, earn from your posts, and be featured on our social channels.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
