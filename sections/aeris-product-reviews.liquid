{%- liquid
  assign review_blog = blogs['list']
  assign review_article = review_blog.articles.first
  assign review_count = 0
  assign review_sum = 0
  assign product_handle = product.handle
-%}
<section class="aeris-reviews" id="AerisReviews">
  <div class="container aeris-reviews__grid">
    <div class="aeris-reviews__score">
      <div class="aeris-reviews__tabs"><span>Reviews</span></div>
      {%- if review_article != blank -%}
        {%- for comment in review_article.comments -%}
          {%- assign parts = comment.content | split: '|' -%}
          {%- if parts[0] == 'AERIS_REVIEW' and parts[2] == product_handle -%}
            {%- assign review_count = review_count | plus: 1 -%}
            {%- assign review_sum = review_sum | plus: parts[1] -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      {%- if review_count > 0 -%}
        {%- assign review_avg = review_sum | times: 10 | divided_by: review_count | times: 1.0 | divided_by: 10 -%}
        <p class="aeris-reviews__number">{{ review_avg }}</p>
        <p class="aeris-reviews__stars" aria-hidden="true">★★★★★</p>
        <p class="aeris-reviews__based">Based on {{ review_count }} reviews</p>
      {%- else -%}
        <p class="aeris-reviews__number">—</p>
        <p class="aeris-reviews__based">No reviews yet</p>
      {%- endif -%}
      <a class="aeris-reviews__write" href="#AerisReviewForm">Write a review</a>
    </div>

    <div class="aeris-reviews__body">
      <h2>Reviews</h2>
      {%- if review_count > 0 -%}
        <ul class="aeris-reviews__list">
          {%- for comment in review_article.comments -%}
            {%- assign parts = comment.content | split: '|' -%}
            {%- if parts[0] == 'AERIS_REVIEW' and parts[2] == product_handle -%}
              <li>
                <p class="aeris-reviews__meta">
                  <span aria-hidden="true">
                    {%- assign stars = parts[1] | plus: 0 -%}
                    {%- for i in (1..5) -%}{% if i <= stars %}★{% else %}☆{% endif %}{%- endfor -%}
                  </span>
                  {{ comment.author }}
                </p>
                <p>{{ parts[3] }}</p>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if review_blog.comments_enabled? and review_article != blank -%}
        <div id="AerisReviewForm">
          {% form 'new_comment', review_article, class: 'aeris-reviews__form' %}
            {%- if form.posted_successfully? -%}
              <p class="aeris-reviews__status" role="status">Thank you. Your review was sent.</p>
            {%- endif -%}
            {%- if form.errors -%}
              <p class="aeris-reviews__status" role="alert">{{ form.errors | default_errors }}</p>
            {%- endif -%}
            <fieldset class="aeris-reviews__stars-input">
              <legend>Rating</legend>
              {%- for i in (1..5) -%}
                <label>
                  <input type="radio" name="aeris_stars" value="{{ i }}" {% if i == 5 %}checked{% endif %}>
                  <span>{{ i }}</span>
                </label>
              {%- endfor -%}
            </fieldset>
            <label class="aeris-reviews__field">
              <span>Name</span>
              <input type="text" name="comment[author]" value="{{ form.author }}" required>
            </label>
            <label class="aeris-reviews__field">
              <span>Email</span>
              <input type="email" name="comment[email]" value="{{ form.email }}" required>
            </label>
            <label class="aeris-reviews__field">
              <span>Review</span>
              <textarea name="aeris_review_text" rows="4" required></textarea>
            </label>
            <input type="hidden" name="comment[body]" data-aeris-review-body>
            <button type="submit">Submit review</button>
          {% endform %}
        </div>
      {%- else -%}
        <p class="aeris-reviews__empty">Reviews can be written once blog comments are turned on for the Journal blog in Shopify admin.</p>
      {%- endif -%}
    </div>
  </div>
</section>
<script>
  (function () {
    var form = document.querySelector('.aeris-reviews__form');
    if (!form) return;
    form.addEventListener('submit', function () {
      var stars = form.querySelector('input[name="aeris_stars"]:checked');
      var text = form.querySelector('[name="aeris_review_text"]');
      var body = form.querySelector('[data-aeris-review-body]');
      var clean = (text.value || '').replace(/\|/g, '/').replace(/\s+/g, ' ').trim();
      body.value = 'AERIS_REVIEW|' + (stars ? stars.value : '5') + '|{{ product.handle }}|' + clean;
    });
  })();
</script>
{% style %}
  .aeris-reviews { padding: 4.8rem 0 6.4rem; }
  .aeris-reviews__grid { display: grid; gap: 2.4rem; }
  .aeris-reviews__score { padding: 2.4rem; background: #f6f3ee; border-radius: 1.2rem; }
  .aeris-reviews__tabs span { letter-spacing: 0.08em; text-transform: uppercase; font-size: 1.2rem; }
  .aeris-reviews__number { margin: 1.2rem 0 0; font-family: Newsreader, Georgia, serif; font-size: 4.8rem; line-height: 1; }
  .aeris-reviews__based, .aeris-reviews__empty, .aeris-reviews__meta { color: #6f6862; }
  .aeris-reviews__write, .aeris-reviews__form button {
    display: inline-flex; margin-top: 1.6rem; padding: 1rem 1.6rem; border: 0; border-radius: 999px;
    background: #1c1c1c; color: #fff; text-decoration: none; letter-spacing: 0.08em; text-transform: uppercase; font-size: 1.2rem; cursor: pointer;
  }
  .aeris-reviews__list { list-style: none; margin: 0 0 2.4rem; padding: 0; display: grid; gap: 1.6rem; }
  .aeris-reviews__list p { margin: 0.4rem 0 0; }
  .aeris-reviews__form { display: grid; gap: 1.2rem; max-width: 52rem; }
  .aeris-reviews__field { display: grid; gap: 0.4rem; }
  .aeris-reviews__field input, .aeris-reviews__field textarea {
    width: 100%; padding: 1.2rem 1.4rem; border: 1px solid #e3dbd2; border-radius: 1.2rem; background: #fff;
  }
  .aeris-reviews__stars-input { display: flex; gap: 0.6rem; margin: 0; padding: 0; border: 0; }
  .aeris-reviews__stars-input legend { margin-right: 0.8rem; }
  .aeris-reviews__stars-input input { position: absolute; opacity: 0; }
  .aeris-reviews__stars-input span {
    display: grid; place-items: center; width: 3.2rem; height: 3.2rem; border-radius: 50%; border: 1px solid #1c1c1c;
  }
  .aeris-reviews__stars-input input:checked + span { background: #1c1c1c; color: #fff; }
  .aeris-reviews__status { margin: 0; }
  @media (min-width: 990px) {
    .aeris-reviews__grid { grid-template-columns: minmax(24rem, 34rem) minmax(0, 1fr); align-items: start; }
  }
{% endstyle %}
{% schema %}
{
  "name": "Aeris product reviews",
  "settings": [],
  "presets": [{ "name": "Aeris product reviews" }]
}
{% endschema %}
