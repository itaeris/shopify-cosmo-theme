{{ 'customer.css' | asset_url | stylesheet_tag }}

<div class="aeris-login">
  <div class="aeris-login__media">
    <img
      src="{{ 'TT_02644.jpg' | file_img_url: '1600x' }}"
      alt=""
      width="1600"
      height="1600"
    >
  </div>
  <div class="aeris-login__panel">
  <div class="f-customer f-customer__login">
    <p class="aeris-login__kicker">Aeris Beauté</p>
    <h1 id="recover" class="text-center" tabindex="-1">
      {{ 'customer.recover_password.title' | t }}
    </h1>
    <div class="text-center">
      <p>
        {{ 'customer.recover_password.subtext' | t }}
      </p>
  
      {%- form 'recover_customer_password', class: 'form' -%}
        {% assign recover_success = form.posted_successfully? %}
        <div class="form-field">
          <input type="email"
            value=""
            name="email"
            id="RecoverEmail"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="RecoverEmail-email-error"
              autofocus
            {% endif %}
            placeholder="{{ 'customer.login_page.email' | t }}"
            class="form-control"
          >
          <label for="RecoverEmail" class="hidden">
            {{ 'customer.login_page.email' | t }}
          </label>
        </div>
        {%- if form.errors -%}
          <small id="RecoverEmail-email-error" class="form-message">
            <svg aria-hidden="true" focusable="false" role="presentation" viewBox="0 0 13 13">
              <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"/>
              <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"/>
              <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
              <path d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z" fill="white" stroke="#EB001B" stroke-width="0.7">
            </svg>
            {{ form.errors.messages['form'] }}
          </small>
        {%- endif -%}
  
        <button class="btn btn--primary">
          {{ 'customer.login_page.submit' | t }}
        </button>
  
        <a href="#login" class="btn btn--underline">
          {{ 'customer.login_page.cancel' | t }}
        </a>
      {%- endform -%}
    </div>
  
    <h1 id="login" class="text-center" tabindex="-1">
      {{ 'customer.login_page.title' | t }}
    </h1>
    <p class="aeris-login__note">
      {%- if request.locale.iso_code == 'id' -%}
        Masuk untuk melihat pesanan, rewards, dan barang tersimpan.
      {%- else -%}
        Sign in to view your orders, rewards, and saved pieces.
      {%- endif -%}
    </p>
    <p class="create-account-link">{{ 'customer.login_page.no_account_text' | t }} <a href="{{ routes.account_register_url }}" class="btn btn--underline btn-view-details">{{ 'customer.login_page.create_account' | t }}</a></p>
    <div>
      {%- if recover_success == true -%}
        <h3 class="form-message" tabindex="-1" autofocus>
          <svg aria-hidden="true" focusable="false" role="presentation" viewBox="0 0 13 13">
            <path d="M6.5 12.35C9.73087 12.35 12.35 9.73086 12.35 6.5C12.35 3.26913 9.73087 0.65 6.5 0.65C3.26913 0.65 0.65 3.26913 0.65 6.5C0.65 9.73086 3.26913 12.35 6.5 12.35Z" fill="#428445" stroke="white" stroke-width="0.7"/>
            <path d="M5.53271 8.66357L9.25213 4.68197" stroke="white"/>
            <path d="M4.10645 6.7688L6.13766 8.62553" stroke="white">
          </svg>
          {{ 'customer.recover_password.success' | t }}
        </h3>
      {%- endif -%}
      {%- form 'customer_login', novalidate: 'novalidate', class: 'form' -%}
        {%- if form.errors -%}
          <h4 class="form-message" tabindex="-1" autofocus>
            <span class="visually-hidden">{{ 'accessibility.error' | t }} </span>
            <svg aria-hidden="true" focusable="false" role="presentation" viewBox="0 0 13 13">
              <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"/>
              <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"/>
              <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
              <path d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z" fill="white" stroke="#EB001B" stroke-width="0.7">
            </svg>
            {{ 'templates.contact.form.error_heading' | t }}
          </h4>
          {{ form.errors | default_errors }}
        {%- endif -%}
  
        <div class="form-field">        
          <input
            type="email"
            name="customer[email]"
            id="CustomerEmail"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            {% if form.errors contains 'form' %}
              aria-invalid="true"
            {% endif %}
            placeholder="{{ 'customer.login_page.email' | t }}"
            class="form-control"
          >
          <label for="CustomerEmail" class="hidden">
            {{ 'customer.login_page.email' | t }}
          </label>
        </div>
  
        {%- if form.password_needed -%}
          <div class="form-field relative">          
            <input
              type="password"
              value=""
              name="customer[password]"
              id="CustomerPassword"
              autocomplete="current-password"
              {% if form.errors contains 'form' %}
                aria-invalid="true"
              {% endif %}
              placeholder="{{ 'customer.login_page.password' | t }}"
              class="form-control"
            >
            <label for="CustomerPassword" class="hidden">
              {{ 'customer.login_page.password' | t }}
            </label>
            <a href="#recover" class="btn btn--underline btn-view-details">
              {{ 'customer.login_page.forgot_password' | t }}
            </a>
          </div>
        {%- endif -%}
        <button class="btn btn--primary">
          {{ 'customer.login_page.sign_in' | t }}
        </button>      
        
      {%- endform -%}
    </div>
    
    {%- if shop.checkout.guest_login -%}
      <div>
        <hr>
        <h2>{{ 'customer.login_page.guest_title' | t }}</h2>
  
        {%- form 'guest_login' -%}
          <button>
            {{ 'customer.login_page.guest_continue' | t }}
          </button>
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>
  </div>
</div>

<style>
  .aeris-login {
    display: grid;
    background: #f6f3ee;
    color: #1c1c1c;
  }
  .aeris-login__media {
    min-height: 28rem;
    overflow: hidden;
    background: #e7e1d8;
  }
  .aeris-login__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 28%;
    display: block;
  }
  .aeris-login__panel {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4.8rem 2.4rem 6.4rem;
  }
  .aeris-login .f-customer {
    width: min(100%, 42rem);
    max-width: 42rem;
    margin: 0;
    padding: 0;
  }
  .aeris-login__kicker {
    margin: 0 0 1.2rem;
    font-size: 1.2rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #8a8178;
  }
  .aeris-login h1 {
    margin: 0;
    font-family: Newsreader, Georgia, serif;
    font-weight: 500;
    font-size: clamp(4rem, 5vw, 5.6rem);
    letter-spacing: 0.01em;
    color: #1c1c1c;
  }
  .aeris-login__note {
    max-width: 34rem;
    margin: 1.2rem auto 0;
    color: #5c564f;
    line-height: 1.6;
  }
  .aeris-login .create-account-link {
    margin: 1.6rem 0 2.8rem;
  }
  #recover:target ~ .aeris-login__note {
    display: none;
  }
  .aeris-login .form-control {
    border-radius: 999px;
    border-color: #e3dbd2;
    background: #fff;
  }
  .aeris-login .form-field.relative {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }
  .aeris-login .form-field.relative .form-control {
    width: 100%;
  }
  .aeris-login a[href="#recover"] {
    position: static;
    top: auto;
    inset-inline-end: auto;
    transform: none;
    margin: 1rem 0.6rem 0 0;
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
    color: #6f6862;
  }
  .aeris-login .btn--primary {
    width: 100%;
    border-radius: 999px;
    background: #1c1c1c;
    color: #fff;
  }
  @media (min-width: 990px) {
    .aeris-login {
      grid-template-columns: minmax(36rem, 46%) minmax(0, 1fr);
      min-height: calc(100vh - 8rem);
    }
    .aeris-login__media {
      min-height: 100%;
    }
  }
</style>
