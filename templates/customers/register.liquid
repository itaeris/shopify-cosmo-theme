{{ 'customer.css' | asset_url | stylesheet_tag }}

<div class="aeris-login">
  <div class="aeris-login__media">
    <img
      src="{{ 'TT_02644.jpg' | file_img_url: '1600x' }}"
      alt=""
      width="1600"
      height="1600"
    >
  </div>
  <div class="aeris-login__panel">
    <div class="f-customer f-customer__register">
      <p class="aeris-login__kicker">Aeris Beauté</p>
      <h1 class="text-center">{{ 'customer.register.title' | t }}</h1>
      <p class="aeris-login__note">
        {%- if request.locale.iso_code == 'id' -%}
          Buat akun untuk melihat pesanan, rewards, dan barang tersimpan.
        {%- else -%}
          Create an account to view your orders, rewards, and saved pieces.
        {%- endif -%}
      </p>
      <p class="create-account-link">
        {{ 'customer.register.already_account' | t }}
        <a href="{{ routes.account_login_url }}" class="btn btn--underline btn-view-details">{{ 'customer.log_in' | t }}</a>
      </p>

      {%- form 'create_customer', novalidate: 'novalidate', class: 'form' -%}
        {%- if form.errors -%}
          <h4 class="form-message" tabindex="-1" autofocus>
            <svg aria-hidden="true" focusable="false" role="presentation" viewBox="0 0 13 13">
              <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"/>
              <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"/>
              <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
              <path d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z" fill="white" stroke="#EB001B" stroke-width="0.7">
            </svg>
            {{ 'templates.contact.form.error_heading' | t }}
          </h4>
          <div class="errors">
            <ul>
              {%- for field in form.errors -%}
                {%- if field == 'form' -%}
                  <li>{{ form.errors.messages[field] }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="form-field">
          <input
            type="text"
            name="customer[first_name]"
            id="RegisterForm-FirstName"
            {% if form.first_name %}value="{{ form.first_name }}"{% endif %}
            autocomplete="given-name"
            placeholder="{{ 'customer.register.first_name' | t }}"
            class="form-control"
          >
          <label for="RegisterForm-FirstName" class="hidden">
            {{ 'customer.register.first_name' | t }}
          </label>
        </div>
        <div class="form-field">
          <input
            type="text"
            name="customer[last_name]"
            id="RegisterForm-LastName"
            {% if form.last_name %}value="{{ form.last_name }}"{% endif %}
            autocomplete="family-name"
            placeholder="{{ 'customer.register.last_name' | t }}"
            class="form-control"
          >
          <label for="RegisterForm-LastName" class="hidden">
            {{ 'customer.register.last_name' | t }}
          </label>
        </div>
        <div class="form-field">
          <input
            type="email"
            name="customer[email]"
            id="RegisterForm-email"
            {% if form.email %}value="{{ form.email }}"{% endif %}
            spellcheck="false"
            autocapitalize="off"
            autocomplete="email"
            aria-required="true"
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="RegisterForm-email-error"
            {% endif %}
            placeholder="{{ 'customer.register.email' | t }}"
            class="form-control"
          >
          <label for="RegisterForm-email" class="hidden">
            {{ 'customer.register.email' | t }}
          </label>
          {%- if form.errors contains 'email' -%}
            <span id="RegisterForm-email-error" class="form-message">
              {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}.
            </span>
          {%- endif -%}
        </div>
        <div class="form-field">
          <input
            type="password"
            name="customer[password]"
            id="RegisterForm-password"
            aria-required="true"
            {% if form.errors contains 'password' %}
              aria-invalid="true"
              aria-describedby="RegisterForm-password-error"
            {% endif %}
            placeholder="{{ 'customer.register.password' | t }}"
            class="form-control"
          >
          <label for="RegisterForm-password" class="hidden">
            {{ 'customer.register.password' | t }}
          </label>
          {%- if form.errors contains 'password' -%}
            <span id="RegisterForm-password-error" class="form-message">
              {{ form.errors.translated_fields['password'] | capitalize }} {{ form.errors.messages['password'] }}.
            </span>
          {%- endif -%}
        </div>

        <button class="btn btn--primary">
          {{ 'customer.register.submit' | t }}
        </button>
      {%- endform -%}
    </div>
  </div>
</div>

<style>
  .aeris-login {
    display: grid;
    background: #f6f3ee;
    color: #1c1c1c;
  }
  .aeris-login__media {
    min-height: 28rem;
    overflow: hidden;
    background: #e7e1d8;
  }
  .aeris-login__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 28%;
    display: block;
  }
  .aeris-login__panel {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4.8rem 2.4rem 6.4rem;
  }
  .aeris-login .f-customer {
    width: min(100%, 42rem);
    max-width: 42rem;
    margin: 0;
    padding: 0;
  }
  .aeris-login__kicker {
    margin: 0 0 1.2rem;
    font-size: 1.2rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #8a8178;
  }
  .aeris-login h1 {
    margin: 0;
    font-family: Newsreader, Georgia, serif;
    font-weight: 500;
    font-size: clamp(4rem, 5vw, 5.6rem);
    letter-spacing: 0.01em;
    color: #1c1c1c;
  }
  .aeris-login__note {
    max-width: 34rem;
    margin: 1.2rem auto 0;
    color: #5c564f;
    line-height: 1.6;
  }
  .aeris-login .create-account-link {
    margin: 1.6rem 0 2.8rem;
  }
  .aeris-login .form-control {
    border-radius: 999px;
    border-color: #e3dbd2;
    background: #fff;
  }
  .aeris-login .btn--primary {
    width: 100%;
    border-radius: 999px;
    background: #1c1c1c;
    color: #fff;
  }
  @media (min-width: 990px) {
    .aeris-login {
      grid-template-columns: minmax(36rem, 46%) minmax(0, 1fr);
      min-height: calc(100vh - 8rem);
    }
    .aeris-login__media {
      min-height: 100%;
    }
  }
</style>
